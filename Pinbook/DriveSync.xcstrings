    "Connect Google Drive" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"ربط Google Drive"}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive'ı bağla"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接 Google 云端硬盘"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連接 Google 雲端硬碟"}},"es":{"stringUnit":{"state":"translated","value":"Conectar Google Drive"}},"fr":{"stringUnit":{"state":"translated","value":"Connecter Google Drive"}},"de":{"stringUnit":{"state":"translated","value":"Google Drive verbinden"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectar o Google Drive"}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive कनेक्ट करें"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan Google Drive"}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブに接続"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브 연결"}},"ru":{"stringUnit":{"state":"translated","value":"Подключить Google Диск"}},"it":{"stringUnit":{"state":"translated","value":"Connetti Google Drive"}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive منسلک کریں"}}}},
    "Sync now" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"مزامنة الآن"}},"tr":{"stringUnit":{"state":"translated","value":"Şimdi eşitle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"立即同步"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"立即同步"}},"es":{"stringUnit":{"state":"translated","value":"Sincronizar ahora"}},"fr":{"stringUnit":{"state":"translated","value":"Synchroniser"}},"de":{"stringUnit":{"state":"translated","value":"Jetzt synchronisieren"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sincronizar agora"}},"hi":{"stringUnit":{"state":"translated","value":"अभी सिंक करें"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronkan sekarang"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ同期"}},"ko":{"stringUnit":{"state":"translated","value":"지금 동기화"}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизировать"}},"it":{"stringUnit":{"state":"translated","value":"Sincronizza ora"}},"ur":{"stringUnit":{"state":"translated","value":"ابھی مطابقت کریں"}}}},
    "Disconnect Google Drive" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"قطع اتصال Google Drive"}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive bağlantısını kes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"断开 Google 云端硬盘"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"中斷 Google 雲端硬碟"}},"es":{"stringUnit":{"state":"translated","value":"Desconectar Google Drive"}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecter Google Drive"}},"de":{"stringUnit":{"state":"translated","value":"Google Drive trennen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desconectar o Google Drive"}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive डिस्कनेक्ट करें"}},"id":{"stringUnit":{"state":"translated","value":"Putuskan Google Drive"}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブの接続を解除"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브 연결 해제"}},"ru":{"stringUnit":{"state":"translated","value":"Отключить Google Диск"}},"it":{"stringUnit":{"state":"translated","value":"Disconnetti Google Drive"}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive کا رابطہ ختم کریں"}}}},
    "Finish disconnect" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إكمال قطع الاتصال"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantıyı kesmeyi tamamla"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成断开连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"完成中斷連線"}},"es":{"stringUnit":{"state":"translated","value":"Finalizar desconexión"}},"fr":{"stringUnit":{"state":"translated","value":"Terminer la déconnexion"}},"de":{"stringUnit":{"state":"translated","value":"Trennung abschließen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Concluir desconexão"}},"hi":{"stringUnit":{"state":"translated","value":"डिस्कनेक्ट पूरा करें"}},"id":{"stringUnit":{"state":"translated","value":"Selesaikan pemutusan"}},"ja":{"stringUnit":{"state":"translated","value":"接続解除を完了"}},"ko":{"stringUnit":{"state":"translated","value":"연결 해제 완료"}},"ru":{"stringUnit":{"state":"translated","value":"Завершить отключение"}},"it":{"stringUnit":{"state":"translated","value":"Completa disconnessione"}},"ur":{"stringUnit":{"state":"translated","value":"رابطہ ختم کرنا مکمل کریں"}}}},
    "Private cloud sync" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"مزامنة سحابية خاصة"}},"tr":{"stringUnit":{"state":"translated","value":"Özel bulut eşitleme"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"私密云同步"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"私人雲端同步"}},"es":{"stringUnit":{"state":"translated","value":"Sincronización privada"}},"fr":{"stringUnit":{"state":"translated","value":"Synchronisation privée"}},"de":{"stringUnit":{"state":"translated","value":"Private Cloud-Synchronisierung"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sincronização privada"}},"hi":{"stringUnit":{"state":"translated","value":"निजी क्लाउड सिंक"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi cloud pribadi"}},"ja":{"stringUnit":{"state":"translated","value":"プライベートクラウド同期"}},"ko":{"stringUnit":{"state":"translated","value":"비공개 클라우드 동기화"}},"ru":{"stringUnit":{"state":"translated","value":"Приватная синхронизация"}},"it":{"stringUnit":{"state":"translated","value":"Sincronizzazione cloud privata"}},"ur":{"stringUnit":{"state":"translated","value":"نجی کلاؤڈ مطابقت"}}}},
    "Pinbook syncs a private backup of your records through Google Drive. Changes are merged safely, and a recovery snapshot is saved before imported changes are applied." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يزامن Pinbook نسخة خاصة من سجلاتك عبر Google Drive. تُدمج التغييرات بأمان وتُحفظ لقطة استعادة قبل تطبيق التغييرات المستوردة."}},"tr":{"stringUnit":{"state":"translated","value":"Pinbook, kayıtlarınızın özel bir yedeğini Google Drive ile eşitler. Değişiklikler güvenle birleştirilir ve içe aktarılan değişiklikler uygulanmadan önce bir kurtarma anlık görüntüsü kaydedilir."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Pinbook 通过 Google 云端硬盘同步记录的私密备份。系统会安全合并更改，并在应用导入内容前保存恢复快照。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Pinbook 透過 Google 雲端硬碟同步記錄的私人備份。系統會安全合併變更，並在套用匯入內容前儲存復原快照。"}},"es":{"stringUnit":{"state":"translated","value":"Pinbook sincroniza una copia privada de tus registros mediante Google Drive. Los cambios se combinan de forma segura y se guarda una instantánea de recuperación antes de aplicar los cambios importados."}},"fr":{"stringUnit":{"state":"translated","value":"Pinbook synchronise une sauvegarde privée de vos données via Google Drive. Les modifications sont fusionnées en toute sécurité et un instantané de récupération est enregistré avant leur application."}},"de":{"stringUnit":{"state":"translated","value":"Pinbook synchronisiert eine private Sicherung Ihrer Daten über Google Drive. Änderungen werden sicher zusammengeführt und vor dem Anwenden importierter Änderungen wird ein Wiederherstellungspunkt gespeichert."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Pinbook sincroniza um backup privado dos seus registros pelo Google Drive. As alterações são mescladas com segurança e um instantâneo de recuperação é salvo antes de aplicar mudanças importadas."}},"hi":{"stringUnit":{"state":"translated","value":"Pinbook Google Drive के माध्यम से आपके रिकॉर्ड का निजी बैकअप सिंक करता है। बदलाव सुरक्षित रूप से मिलाए जाते हैं और आयातित बदलाव लागू करने से पहले पुनर्प्राप्ति स्नैपशॉट सहेजा जाता है।"}},"id":{"stringUnit":{"state":"translated","value":"Pinbook menyinkronkan cadangan pribadi catatan Anda melalui Google Drive. Perubahan digabungkan dengan aman dan snapshot pemulihan disimpan sebelum perubahan impor diterapkan."}},"ja":{"stringUnit":{"state":"translated","value":"Pinbook は Google ドライブ経由で記録の非公開バックアップを同期します。変更は安全に統合され、取り込んだ変更を適用する前に復元用スナップショットが保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Pinbook은 Google 드라이브를 통해 기록의 비공개 백업을 동기화합니다. 변경 사항을 안전하게 병합하고 가져온 변경을 적용하기 전에 복구 스냅샷을 저장합니다."}},"ru":{"stringUnit":{"state":"translated","value":"Pinbook синхронизирует приватную резервную копию записей через Google Диск. Изменения безопасно объединяются, а перед их применением сохраняется снимок для восстановления."}},"it":{"stringUnit":{"state":"translated","value":"Pinbook sincronizza un backup privato dei tuoi dati tramite Google Drive. Le modifiche vengono unite in sicurezza e prima di applicarle viene salvata un'istantanea di ripristino."}},"ur":{"stringUnit":{"state":"translated","value":"Pinbook آپ کے ریکارڈز کا نجی بیک اپ Google Drive کے ذریعے ہم آہنگ کرتا ہے۔ تبدیلیاں محفوظ طریقے سے یکجا ہوتی ہیں اور درآمد شدہ تبدیلیاں لاگو کرنے سے پہلے بحالی اسنیپ شاٹ محفوظ کیا جاتا ہے۔"}}}},
    "Connect" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اتصال"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"連接"}},"es":{"stringUnit":{"state":"translated","value":"Conectar"}},"fr":{"stringUnit":{"state":"translated","value":"Connecter"}},"de":{"stringUnit":{"state":"translated","value":"Verbinden"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Conectar"}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्ट करें"}},"id":{"stringUnit":{"state":"translated","value":"Hubungkan"}},"ja":{"stringUnit":{"state":"translated","value":"接続"}},"ko":{"stringUnit":{"state":"translated","value":"연결"}},"ru":{"stringUnit":{"state":"translated","value":"Подключить"}},"it":{"stringUnit":{"state":"translated","value":"Connetti"}},"ur":{"stringUnit":{"state":"translated","value":"منسلک کریں"}}}},
    "Pinbook will request access only to its private app data folder. It cannot read your other Google Drive files." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"سيطلب Pinbook الوصول إلى مجلد بياناته الخاص فقط، ولن يتمكن من قراءة ملفاتك الأخرى في Google Drive."}},"tr":{"stringUnit":{"state":"translated","value":"Pinbook yalnızca özel uygulama veri klasörüne erişim ister. Diğer Google Drive dosyalarınızı okuyamaz."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Pinbook 只会请求访问其私密应用数据文件夹，无法读取您在 Google 云端硬盘中的其他文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Pinbook 只會要求存取其私人 App 資料夾，無法讀取您在 Google 雲端硬碟中的其他檔案。"}},"es":{"stringUnit":{"state":"translated","value":"Pinbook solo solicitará acceso a su carpeta privada de datos. No puede leer tus demás archivos de Google Drive."}},"fr":{"stringUnit":{"state":"translated","value":"Pinbook demandera uniquement l'accès à son dossier de données privé. Il ne peut pas lire vos autres fichiers Google Drive."}},"de":{"stringUnit":{"state":"translated","value":"Pinbook fordert nur Zugriff auf seinen privaten App-Datenordner an. Andere Google-Drive-Dateien können nicht gelesen werden."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Pinbook solicitará acesso somente à pasta privada de dados do app. Ele não pode ler seus outros arquivos do Google Drive."}},"hi":{"stringUnit":{"state":"translated","value":"Pinbook केवल अपने निजी ऐप डेटा फ़ोल्डर की अनुमति मांगेगा। यह आपकी अन्य Google Drive फ़ाइलें नहीं पढ़ सकता।"}},"id":{"stringUnit":{"state":"translated","value":"Pinbook hanya akan meminta akses ke folder data aplikasi pribadinya. Pinbook tidak dapat membaca file Google Drive Anda yang lain."}},"ja":{"stringUnit":{"state":"translated","value":"Pinbook がアクセスを求めるのは専用の非公開アプリデータフォルダだけです。他の Google ドライブのファイルは読み取れません。"}},"ko":{"stringUnit":{"state":"translated","value":"Pinbook은 전용 비공개 앱 데이터 폴더에만 접근을 요청합니다. 다른 Google 드라이브 파일은 읽을 수 없습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Pinbook запросит доступ только к своей закрытой папке данных приложения и не сможет читать другие файлы на Google Диске."}},"it":{"stringUnit":{"state":"translated","value":"Pinbook richiederà l'accesso solo alla propria cartella dati privata. Non può leggere gli altri file di Google Drive."}},"ur":{"stringUnit":{"state":"translated","value":"Pinbook صرف اپنے نجی ایپ ڈیٹا فولڈر تک رسائی مانگے گا۔ یہ آپ کی دوسری Google Drive فائلیں نہیں پڑھ سکتا۔"}}}},
    "Disconnect" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"قطع الاتصال"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantıyı kes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"断开连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"中斷連線"}},"es":{"stringUnit":{"state":"translated","value":"Desconectar"}},"fr":{"stringUnit":{"state":"translated","value":"Déconnecter"}},"de":{"stringUnit":{"state":"translated","value":"Trennen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desconectar"}},"hi":{"stringUnit":{"state":"translated","value":"डिस्कनेक्ट करें"}},"id":{"stringUnit":{"state":"translated","value":"Putuskan"}},"ja":{"stringUnit":{"state":"translated","value":"接続解除"}},"ko":{"stringUnit":{"state":"translated","value":"연결 해제"}},"ru":{"stringUnit":{"state":"translated","value":"Отключить"}},"it":{"stringUnit":{"state":"translated","value":"Disconnetti"}},"ur":{"stringUnit":{"state":"translated","value":"رابطہ ختم کریں"}}}},
    "Keep connected" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"إبقاء الاتصال"}},"tr":{"stringUnit":{"state":"translated","value":"Bağlı tut"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保持连接"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"保持連線"}},"es":{"stringUnit":{"state":"translated","value":"Mantener conectado"}},"fr":{"stringUnit":{"state":"translated","value":"Rester connecté"}},"de":{"stringUnit":{"state":"translated","value":"Verbunden lassen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Manter conectado"}},"hi":{"stringUnit":{"state":"translated","value":"कनेक्टेड रखें"}},"id":{"stringUnit":{"state":"translated","value":"Tetap terhubung"}},"ja":{"stringUnit":{"state":"translated","value":"接続を維持"}},"ko":{"stringUnit":{"state":"translated","value":"연결 유지"}},"ru":{"stringUnit":{"state":"translated","value":"Оставить подключённым"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni connesso"}},"ur":{"stringUnit":{"state":"translated","value":"منسلک رکھیں"}}}},
    "Disconnecting stops future sync. Your local Pinbook records and existing private Drive backups stay in place." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يوقف قطع الاتصال المزامنة مستقبلاً. تبقى سجلات Pinbook المحلية والنسخ الخاصة الموجودة في Drive كما هي."}},"tr":{"stringUnit":{"state":"translated","value":"Bağlantıyı kesmek gelecekteki eşitlemeyi durdurur. Yerel Pinbook kayıtlarınız ve mevcut özel Drive yedekleriniz korunur."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"断开连接会停止今后的同步。本地 Pinbook 记录和现有私密 Drive 备份都会保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"中斷連線會停止之後的同步。本機 Pinbook 記錄和現有私人 Drive 備份都會保留。"}},"es":{"stringUnit":{"state":"translated","value":"Al desconectar se detiene la sincronización futura. Tus registros locales y las copias privadas existentes en Drive se conservan."}},"fr":{"stringUnit":{"state":"translated","value":"La déconnexion arrête les futures synchronisations. Vos données locales et sauvegardes privées Drive existantes sont conservées."}},"de":{"stringUnit":{"state":"translated","value":"Durch das Trennen werden künftige Synchronisierungen beendet. Lokale Pinbook-Daten und vorhandene private Drive-Sicherungen bleiben erhalten."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Desconectar interrompe futuras sincronizações. Seus registros locais e backups privados existentes no Drive permanecem no lugar."}},"hi":{"stringUnit":{"state":"translated","value":"डिस्कनेक्ट करने पर आगे का सिंक रुक जाएगा। आपके स्थानीय Pinbook रिकॉर्ड और मौजूदा निजी Drive बैकअप बने रहेंगे।"}},"id":{"stringUnit":{"state":"translated","value":"Memutuskan koneksi menghentikan sinkronisasi berikutnya. Catatan Pinbook lokal dan cadangan Drive pribadi yang ada tetap tersimpan."}},"ja":{"stringUnit":{"state":"translated","value":"接続を解除すると今後の同期が停止します。端末内の Pinbook 記録と既存の非公開 Drive バックアップは残ります。"}},"ko":{"stringUnit":{"state":"translated","value":"연결을 해제하면 이후 동기화가 중지됩니다. 로컬 Pinbook 기록과 기존 비공개 Drive 백업은 그대로 유지됩니다."}},"ru":{"stringUnit":{"state":"translated","value":"После отключения дальнейшая синхронизация прекратится. Локальные записи Pinbook и существующие приватные копии на Диске сохранятся."}},"it":{"stringUnit":{"state":"translated","value":"La disconnessione interrompe le sincronizzazioni future. I dati locali e i backup privati esistenti su Drive restano al loro posto."}},"ur":{"stringUnit":{"state":"translated","value":"رابطہ ختم کرنے سے آئندہ مطابقت رک جائے گی۔ مقامی Pinbook ریکارڈز اور Drive پر موجود نجی بیک اپ برقرار رہیں گے۔"}}}},
    "Google Drive connected. Tap Sync now to merge your records." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تم ربط Google Drive. اضغط «مزامنة الآن» لدمج سجلاتك."}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive bağlandı. Kayıtlarınızı birleştirmek için Şimdi eşitle'ye dokunun."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google 云端硬盘已连接。轻点“立即同步”以合并记录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Google 雲端硬碟已連接。點一下「立即同步」以合併記錄。"}},"es":{"stringUnit":{"state":"translated","value":"Google Drive está conectado. Toca Sincronizar ahora para combinar tus registros."}},"fr":{"stringUnit":{"state":"translated","value":"Google Drive est connecté. Touchez Synchroniser pour fusionner vos données."}},"de":{"stringUnit":{"state":"translated","value":"Google Drive ist verbunden. Tippen Sie auf „Jetzt synchronisieren“, um Ihre Daten zusammenzuführen."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Google Drive conectado. Toque em Sincronizar agora para mesclar seus registros."}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive कनेक्ट हो गया। रिकॉर्ड मिलाने के लिए अभी सिंक करें पर टैप करें।"}},"id":{"stringUnit":{"state":"translated","value":"Google Drive terhubung. Ketuk Sinkronkan sekarang untuk menggabungkan catatan Anda."}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブに接続しました。「今すぐ同期」をタップして記録を統合してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브에 연결했습니다. 지금 동기화를 탭하여 기록을 병합하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Google Диск подключён. Нажмите «Синхронизировать», чтобы объединить записи."}},"it":{"stringUnit":{"state":"translated","value":"Google Drive è connesso. Tocca Sincronizza ora per unire i tuoi dati."}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive منسلک ہو گیا۔ ریکارڈز یکجا کرنے کے لیے ابھی مطابقت کریں پر ٹیپ کریں۔"}}}},
    "Google Drive disconnected." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تم قطع اتصال Google Drive."}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive bağlantısı kesildi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google 云端硬盘已断开连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Google 雲端硬碟已中斷連線。"}},"es":{"stringUnit":{"state":"translated","value":"Google Drive se desconectó."}},"fr":{"stringUnit":{"state":"translated","value":"Google Drive est déconnecté."}},"de":{"stringUnit":{"state":"translated","value":"Google Drive wurde getrennt."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Google Drive desconectado."}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive डिस्कनेक्ट हो गया।"}},"id":{"stringUnit":{"state":"translated","value":"Google Drive telah diputuskan."}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブの接続を解除しました。"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브 연결이 해제되었습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Google Диск отключён."}},"it":{"stringUnit":{"state":"translated","value":"Google Drive è disconnesso."}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive کا رابطہ ختم ہو گیا۔"}}}},
    "Sync complete. Your merged backup was saved to Google Drive." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اكتملت المزامنة. حُفظت النسخة المدمجة في Google Drive."}},"tr":{"stringUnit":{"state":"translated","value":"Eşitleme tamamlandı. Birleştirilmiş yedeğiniz Google Drive'a kaydedildi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步完成。合并后的备份已保存到 Google 云端硬盘。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"同步完成。合併後的備份已儲存至 Google 雲端硬碟。"}},"es":{"stringUnit":{"state":"translated","value":"Sincronización completa. La copia combinada se guardó en Google Drive."}},"fr":{"stringUnit":{"state":"translated","value":"Synchronisation terminée. La sauvegarde fusionnée a été enregistrée dans Google Drive."}},"de":{"stringUnit":{"state":"translated","value":"Synchronisierung abgeschlossen. Die zusammengeführte Sicherung wurde in Google Drive gespeichert."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sincronização concluída. O backup mesclado foi salvo no Google Drive."}},"hi":{"stringUnit":{"state":"translated","value":"सिंक पूरा हुआ। मिला हुआ बैकअप Google Drive में सहेजा गया।"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi selesai. Cadangan gabungan disimpan ke Google Drive."}},"ja":{"stringUnit":{"state":"translated","value":"同期が完了しました。統合したバックアップを Google ドライブに保存しました。"}},"ko":{"stringUnit":{"state":"translated","value":"동기화가 완료되었습니다. 병합된 백업을 Google 드라이브에 저장했습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация завершена. Объединённая резервная копия сохранена на Google Диске."}},"it":{"stringUnit":{"state":"translated","value":"Sincronizzazione completata. Il backup unito è stato salvato su Google Drive."}},"ur":{"stringUnit":{"state":"translated","value":"مطابقت مکمل ہو گئی۔ یکجا بیک اپ Google Drive پر محفوظ ہو گیا۔"}}}},
    "Sync complete. Your records are already up to date." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"اكتملت المزامنة. سجلاتك محدثة بالفعل."}},"tr":{"stringUnit":{"state":"translated","value":"Eşitleme tamamlandı. Kayıtlarınız zaten güncel."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步完成。您的记录已是最新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"同步完成。您的記錄已是最新。"}},"es":{"stringUnit":{"state":"translated","value":"Sincronización completa. Tus registros ya están actualizados."}},"fr":{"stringUnit":{"state":"translated","value":"Synchronisation terminée. Vos données sont déjà à jour."}},"de":{"stringUnit":{"state":"translated","value":"Synchronisierung abgeschlossen. Ihre Daten sind bereits aktuell."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sincronização concluída. Seus registros já estão atualizados."}},"hi":{"stringUnit":{"state":"translated","value":"सिंक पूरा हुआ। आपके रिकॉर्ड पहले से नवीनतम हैं।"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi selesai. Catatan Anda sudah terbaru."}},"ja":{"stringUnit":{"state":"translated","value":"同期が完了しました。記録はすでに最新です。"}},"ko":{"stringUnit":{"state":"translated","value":"동기화가 완료되었습니다. 기록이 이미 최신 상태입니다."}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизация завершена. Записи уже актуальны."}},"it":{"stringUnit":{"state":"translated","value":"Sincronizzazione completata. I tuoi dati sono già aggiornati."}},"ur":{"stringUnit":{"state":"translated","value":"مطابقت مکمل ہو گئی۔ آپ کے ریکارڈز پہلے ہی تازہ ہیں۔"}}}},
    "Google Drive needs cleanup. Tap Finish disconnect, then connect again." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"يحتاج Google Drive إلى تنظيف. اضغط «إكمال قطع الاتصال»، ثم أعد الاتصال."}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive temizleme gerektiriyor. Bağlantıyı kesmeyi tamamla'ya dokunun, sonra yeniden bağlanın."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google 云端硬盘需要清理。轻点“完成断开连接”，然后重新连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Google 雲端硬碟需要清理。點一下「完成中斷連線」，然後重新連接。"}},"es":{"stringUnit":{"state":"translated","value":"Google Drive necesita una limpieza. Toca Finalizar desconexión y vuelve a conectar."}},"fr":{"stringUnit":{"state":"translated","value":"Google Drive nécessite un nettoyage. Touchez Terminer la déconnexion, puis reconnectez-vous."}},"de":{"stringUnit":{"state":"translated","value":"Google Drive muss bereinigt werden. Tippen Sie auf „Trennung abschließen“ und verbinden Sie es erneut."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Google Drive precisa de limpeza. Toque em Concluir desconexão e conecte novamente."}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive को साफ़ करना आवश्यक है। डिस्कनेक्ट पूरा करें पर टैप करें, फिर दोबारा कनेक्ट करें।"}},"id":{"stringUnit":{"state":"translated","value":"Google Drive perlu dibersihkan. Ketuk Selesaikan pemutusan, lalu hubungkan lagi."}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブのクリーンアップが必要です。「接続解除を完了」をタップしてから再接続してください。"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브 정리가 필요합니다. 연결 해제 완료를 탭한 후 다시 연결하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Google Диск требует очистки. Нажмите «Завершить отключение», затем подключитесь снова."}},"it":{"stringUnit":{"state":"translated","value":"Google Drive richiede una pulizia. Tocca Completa disconnessione, quindi connettiti di nuovo."}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive کی صفائی درکار ہے۔ رابطہ ختم کرنا مکمل کریں پر ٹیپ کریں، پھر دوبارہ منسلک ہوں۔"}}}},
    "Google Drive is not connected." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"Google Drive غير متصل."}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive bağlı değil."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google 云端硬盘未连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Google 雲端硬碟未連線。"}},"es":{"stringUnit":{"state":"translated","value":"Google Drive no está conectado."}},"fr":{"stringUnit":{"state":"translated","value":"Google Drive n'est pas connecté."}},"de":{"stringUnit":{"state":"translated","value":"Google Drive ist nicht verbunden."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Google Drive não está conectado."}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive कनेक्ट नहीं है।"}},"id":{"stringUnit":{"state":"translated","value":"Google Drive belum terhubung."}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブに接続されていません。"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브가 연결되지 않았습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Google Диск не подключён."}},"it":{"stringUnit":{"state":"translated","value":"Google Drive non è connesso."}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive منسلک نہیں ہے۔"}}}},
    "Google Drive sync could not finish. Check your connection and try again." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تعذر إكمال مزامنة Google Drive. تحقق من اتصالك وحاول مجددًا."}},"tr":{"stringUnit":{"state":"translated","value":"Google Drive eşitlemesi tamamlanamadı. Bağlantınızı kontrol edip yeniden deneyin."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google 云端硬盘同步未能完成。请检查网络连接并重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Google 雲端硬碟同步未能完成。請檢查網路連線並再試一次。"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo completar la sincronización con Google Drive. Comprueba tu conexión e inténtalo de nuevo."}},"fr":{"stringUnit":{"state":"translated","value":"La synchronisation Google Drive n'a pas abouti. Vérifiez votre connexion et réessayez."}},"de":{"stringUnit":{"state":"translated","value":"Die Google-Drive-Synchronisierung konnte nicht abgeschlossen werden. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível concluir a sincronização com o Google Drive. Verifique sua conexão e tente novamente."}},"hi":{"stringUnit":{"state":"translated","value":"Google Drive सिंक पूरा नहीं हो सका। अपना कनेक्शन जांचें और फिर कोशिश करें।"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi Google Drive tidak dapat diselesaikan. Periksa koneksi Anda dan coba lagi."}},"ja":{"stringUnit":{"state":"translated","value":"Google ドライブの同期を完了できませんでした。接続を確認して、もう一度お試しください。"}},"ko":{"stringUnit":{"state":"translated","value":"Google 드라이브 동기화를 완료하지 못했습니다. 연결을 확인하고 다시 시도하세요."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось завершить синхронизацию с Google Диском. Проверьте подключение и повторите попытку."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile completare la sincronizzazione con Google Drive. Controlla la connessione e riprova."}},"ur":{"stringUnit":{"state":"translated","value":"Google Drive مطابقت مکمل نہیں ہو سکی۔ اپنا رابطہ چیک کریں اور دوبارہ کوشش کریں۔"}}}},
    "Sync automatically" : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"المزامنة تلقائيًا"}},"tr":{"stringUnit":{"state":"translated","value":"Otomatik eşitle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动同步"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動同步"}},"es":{"stringUnit":{"state":"translated","value":"Sincronizar automáticamente"}},"fr":{"stringUnit":{"state":"translated","value":"Synchroniser automatiquement"}},"de":{"stringUnit":{"state":"translated","value":"Automatisch synchronisieren"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Sincronizar automaticamente"}},"hi":{"stringUnit":{"state":"translated","value":"अपने आप सिंक करें"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronkan otomatis"}},"ja":{"stringUnit":{"state":"translated","value":"自動的に同期"}},"ko":{"stringUnit":{"state":"translated","value":"자동 동기화"}},"ru":{"stringUnit":{"state":"translated","value":"Синхронизировать автоматически"}},"it":{"stringUnit":{"state":"translated","value":"Sincronizza automaticamente"}},"ur":{"stringUnit":{"state":"translated","value":"خودکار مطابقت"}}}},
    "Automatic sync runs when Pinbook opens. You can still sync manually at any time." : {"localizations":{"ar":{"stringUnit":{"state":"translated","value":"تعمل المزامنة التلقائية عند فتح Pinbook، ويمكنك المزامنة يدويًا في أي وقت."}},"tr":{"stringUnit":{"state":"translated","value":"Otomatik eşitleme Pinbook açıldığında çalışır. İstediğiniz zaman elle de eşitleyebilirsiniz."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Pinbook 时会自动同步。您仍可随时手动同步。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟 Pinbook 時會自動同步。您仍可隨時手動同步。"}},"es":{"stringUnit":{"state":"translated","value":"La sincronización automática se ejecuta al abrir Pinbook. También puedes sincronizar manualmente en cualquier momento."}},"fr":{"stringUnit":{"state":"translated","value":"La synchronisation automatique s'exécute à l'ouverture de Pinbook. Vous pouvez aussi synchroniser manuellement à tout moment."}},"de":{"stringUnit":{"state":"translated","value":"Die automatische Synchronisierung läuft beim Öffnen von Pinbook. Sie können jederzeit auch manuell synchronisieren."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sincronização automática é executada ao abrir o Pinbook. Você também pode sincronizar manualmente a qualquer momento."}},"hi":{"stringUnit":{"state":"translated","value":"Pinbook खुलने पर अपने आप सिंक होता है। आप किसी भी समय मैन्युअल रूप से भी सिंक कर सकते हैं।"}},"id":{"stringUnit":{"state":"translated","value":"Sinkronisasi otomatis berjalan saat Pinbook dibuka. Anda tetap dapat menyinkronkan secara manual kapan saja."}},"ja":{"stringUnit":{"state":"translated","value":"Pinbook を開くと自動同期が実行されます。いつでも手動で同期できます。"}},"ko":{"stringUnit":{"state":"translated","value":"Pinbook을 열면 자동 동기화가 실행됩니다. 언제든 수동으로 동기화할 수도 있습니다."}},"ru":{"stringUnit":{"state":"translated","value":"Автоматическая синхронизация запускается при открытии Pinbook. В любое время можно выполнить её вручную."}},"it":{"stringUnit":{"state":"translated","value":"La sincronizzazione automatica viene eseguita all'apertura di Pinbook. Puoi comunque sincronizzare manualmente in qualsiasi momento."}},"ur":{"stringUnit":{"state":"translated","value":"Pinbook کھلنے پر خودکار مطابقت چلتی ہے۔ آپ کسی بھی وقت دستی طور پر بھی مطابقت کر سکتے ہیں۔"}}}}
  },
  "version" : "1.1"
}
