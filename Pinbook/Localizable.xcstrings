            "value": "لا توجد مصروفات مؤرشفة"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无已归档支出"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune dépense archivée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin gastos archivados"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna spesa archiviata"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine archivierten Ausgaben"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma despesa arquivada"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenmiş gider yok"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無已歸檔支出"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pengeluaran diarsipkan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブした支出はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 지출 없음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет архивных расходов"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई संग्रहीत खर्च नहीं"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظات میں کوئی خرچ نہیں"
          }
        }
      }
    },
    "Notification permission will be requested only when reminder delivery is implemented.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُطلب إذن الإشعارات إلا بعد تنفيذ إرسال التذكيرات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在提醒推送功能实现后才会请求通知权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de notification sera demandée uniquement lorsque l’envoi des rappels sera disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de notificaciones solo se solicitará cuando el envío de recordatorios esté disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso per le notifiche verrà richiesto solo quando l’invio dei promemoria sarà disponibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigungsberechtigung wird erst angefragt, wenn die Erinnerungszustellung verfügbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de notificações só será solicitada quando o envio de lembretes estiver disponível."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni, hatırlatıcı gönderimi kullanıma sunulduğunda istenecektir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒通知功能推出後，才會要求通知權限。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin notifikasi hanya akan diminta setelah pengiriman pengingat tersedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの通知機能が利用可能になった際に、通知の許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 발송 기능이 제공될 때만 알림 권한을 요청합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на уведомления будет запрошено только после появления отправки напоминаний."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर भेजने की सुविधा उपलब्ध होने पर ही सूचना की अनुमति माँगी जाएगी।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی بھیجنے کی سہولت دستیاب ہونے پر ہی اطلاعات کی اجازت مانگی جائے گی۔"
          }
        }
      },
      "extractionState": "stale"
    },
    "Notification text is intentionally generic so financial details do not appear on the Lock Screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص الإشعار عام عمداً حتى لا تظهر التفاصيل المالية على شاشة القفل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知文本会刻意保持概括，避免财务详情显示在锁定屏幕上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte des notifications reste volontairement générique pour ne pas afficher de détails financiers sur l’écran verrouillé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de las notificaciones es genérico para que no aparezcan detalles financieros en la pantalla bloqueada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo delle notifiche è volutamente generico per non mostrare dettagli finanziari sulla schermata di blocco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind bewusst allgemein formuliert, damit keine Finanzdetails auf dem Sperrbildschirm erscheinen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto das notificações é genérico de propósito para não mostrar detalhes financeiros na Tela Bloqueada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli Ekran’da mali ayrıntıların görünmemesi için bildirim metni bilerek genel tutulur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知刻意使用一般性文字，避免在鎖定畫面顯示財務明細。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks notifikasi sengaja dibuat umum agar detail keuangan tidak muncul di Layar Terkunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面に金銭情報が表示されないよう、通知には一般的な文面を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에 금융 정보가 표시되지 않도록 알림에는 일반적인 문구만 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст уведомлений намеренно нейтрален, чтобы финансовые сведения не появлялись на экране блокировки."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना का पाठ जानबूझकर सामान्य रखा जाता है ताकि लॉक स्क्रीन पर वित्तीय जानकारी न दिखे।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات کا متن جان بوجھ کر عمومی رکھا جاتا ہے تاکہ لاک اسکرین پر مالی تفصیلات ظاہر نہ ہوں۔"
          }
        }
      }
    },
    "Notifications are disabled. Turn off the reminder or enable notifications in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطلة. أوقف التذكير أو فعّل الإشعارات من الإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请关闭该提醒，或在“设置”中启用通知。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Désactivez le rappel ou autorisez les notifications dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Desactiva el recordatorio o permite las notificaciones en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Disattiva il promemoria o abilita le notifiche in Impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind deaktiviert. Schalte die Erinnerung aus oder erlaube Benachrichtigungen in den Einstellungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Desative o lembrete ou permita as notificações em Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı. Hatırlatıcıyı kapatın veya Ayarlar’dan bildirimlere izin verin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已停用。請關閉此提醒，或前往「設定」允許通知。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dinonaktifkan. Matikan pengingat atau izinkan notifikasi di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が無効です。リマインダーをオフにするか、「設定」で通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 이 알림을 끄거나 설정에서 알림을 허용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Отключите напоминание или разрешите уведомления в Настройках."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ बंद हैं। रिमाइंडर बंद करें या सेटिंग्ज़ में सूचनाओं की अनुमति दें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات بند ہیں۔ یاد دہانی بند کریں یا ترتیبات میں اطلاعات کی اجازت دیں۔"
          }
        }
      }
    },
