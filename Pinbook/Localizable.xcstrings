    "Attach a receipt photo to keep it with this expense.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرفق صورة إيصال للاحتفاظ بها مع هذا المصروف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上收据照片，与此支出一起保存。"
