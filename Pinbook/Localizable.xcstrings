    "Last 8 characters from the saved key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر 8 أحرف من المفتاح المحفوظ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存密钥的最后 8 个字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
