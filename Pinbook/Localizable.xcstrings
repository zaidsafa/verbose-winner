    "Key setup could not be confirmed. Check the saved key before trying again. Existing keys are never replaced.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تأكيد إعداد المفتاح. تحقق من المفتاح المحفوظ قبل المحاولة مجددًا. لا يتم استبدال المفاتيح الموجودة مطلقًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认密钥设置。请检查已保存的密钥后重试。绝不会替换现有密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認金鑰設定。請檢查已儲存的金鑰後重試。絕不會取代現有金鑰。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration de la clé n’a pas pu être confirmée. Vérifiez la clé enregistrée avant de réessayer. Les clés existantes ne sont jamais remplacées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la configuración de la clave. Comprueba la clave guardada antes de volver a intentarlo. Las claves existentes nunca se reemplazan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüsseleinrichtung konnte nicht bestätigt werden. Prüfe den gespeicherten Schlüssel, bevor du es erneut versuchst. Vorhandene Schlüssel werden nie ersetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare la configurazione della chiave. Controlla la chiave salvata prima di riprovare. Le chiavi esistenti non vengono mai sostituite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a configuração da chave. Verifique a chave salva antes de tentar novamente. As chaves existentes nunca são substituídas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kurulumu doğrulanamadı. Yeniden denemeden önce kayıtlı anahtarı kontrol edin. Mevcut anahtarlar asla değiştirilmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan kunci tidak dapat dikonfirmasi. Periksa kunci yang disimpan sebelum mencoba lagi. Kunci yang ada tidak pernah diganti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの設定を確認できませんでした。再試行する前に保存したキーを確認してください。既存のキーは置き換えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 설정을 확인할 수 없습니다. 다시 시도하기 전에 저장된 키를 확인하세요. 기존 키는 교체되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить настройку ключа. Перед повторной попыткой проверьте сохранённый ключ. Существующие ключи никогда не заменяются."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी के सेटअप की पुष्टि नहीं हो सकी। दोबारा कोशिश करने से पहले सहेजी गई कुंजी जाँचें। मौजूदा कुंजी कभी बदली नहीं जाती।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید کے سیٹ اپ کی تصدیق نہیں ہو سکی۔ دوبارہ کوشش کرنے سے پہلے محفوظ کلید چیک کریں۔ موجودہ کلیدیں کبھی تبدیل نہیں کی جاتیں۔"
          }
        }
      }
    },
    "Recovery key saved on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ مفتاح الاسترداد على هذا الجهاز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复密钥已保存在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原金鑰已儲存在此裝置上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé de récupération enregistrée sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de recuperación guardada en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsschlüssel auf diesem Gerät gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave di recupero salvata su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave de recuperação salva neste dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı bu cihaza kaydedildi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci pemulihan disimpan di perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに復元キーを保存しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 복구 키가 저장되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления сохранён на этом устройстве."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर पुनर्प्राप्ति कुंजी सहेजी गई।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر بازیابی کی کلید محفوظ ہو گئی۔"
          }
        }
      }
    },
    "A restore may have completed. Import and preview the archive again to check the current records.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما اكتمل الاسترداد. استورد الأرشيف واعرض معاينته مجددًا للتحقق من السجلات الحالية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复可能已完成。请重新导入并预览归档，以检查当前记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原可能已完成。請重新匯入並預覽封存檔，以檢查目前的記錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration a peut-être abouti. Importez l’archive et affichez à nouveau l’aperçu pour vérifier les données actuelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración podría haberse completado. Importa y previsualiza el archivo otra vez para comprobar los registros actuales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung wurde möglicherweise abgeschlossen. Importiere das Archiv erneut und prüfe die aktuellen Einträge in der Vorschau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino potrebbe essere stato completato. Importa l’archivio e visualizza di nuovo l’anteprima per verificare i dati attuali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração pode ter sido concluída. Importe o arquivo e visualize a prévia novamente para verificar os registros atuais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme tamamlanmış olabilir. Güncel kayıtları kontrol etmek için arşivi yeniden içe aktarıp önizleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan mungkin telah selesai. Impor dan pratinjau arsip kembali untuk memeriksa catatan saat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元が完了している可能性があります。現在の記録を確認するには、アーカイブをもう一度読み込み、プレビューしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원이 완료되었을 수 있습니다. 현재 기록을 확인하려면 보관 파일을 다시 가져와 미리보기를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление могло завершиться. Импортируйте архив и снова откройте предпросмотр, чтобы проверить текущие записи."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाली पूरी हो चुकी हो सकती है। मौजूदा रिकॉर्ड जाँचने के लिए आर्काइव को फिर से आयात करके प्रीव्यू देखें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن ہے بحالی مکمل ہو گئی ہو۔ موجودہ ریکارڈ دیکھنے کے لیے آرکائیو دوبارہ درآمد کریں اور پیش منظر دیکھیں۔"
          }
        }
      }
    },
    "Only received text notes are included. This does not restore team access, sent drafts, revisions or attachments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن النسخة الملاحظات النصية المستلمة فقط. لا تستعيد الوصول إلى الفريق أو مسودات الإرسال أو المراجعات أو المرفقات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含已接收的文字笔记。不会恢复团队访问权限、发送草稿、修订记录或附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅包含已接收的文字筆記。不會還原團隊存取權、傳送草稿、修訂記錄或附件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les notes textuelles reçues sont incluses. L’accès aux équipes, les brouillons d’envoi, les révisions et les pièces jointes ne sont pas restaurés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se incluyen las notas de texto recibidas. No se restauran el acceso a equipos, los borradores de envío, las revisiones ni los adjuntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind nur empfangene Textnotizen enthalten. Teamzugriff, Sendeentwürfe, Überarbeitungen und Anhänge werden nicht wiederhergestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono incluse solo le note di testo ricevute. Non vengono ripristinati l’accesso ai team, le bozze di invio, le revisioni o gli allegati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente notas de texto recebidas são incluídas. O acesso às equipes, rascunhos de envio, revisões e anexos não são restaurados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca alınan metin notları dahildir. Ekip erişimi, gönderim taslakları, düzenlemeler veya ekler geri yüklenmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya catatan teks yang diterima yang disertakan. Akses tim, draf pengiriman, revisi, dan lampiran tidak dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信したテキストノートのみが含まれます。チームへのアクセス、送信用の下書き、改訂履歴、添付ファイルは復元されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 텍스트 노트만 포함됩니다. 팀 접근 권한, 전송 초안, 수정 내역 또는 첨부 파일은 복원되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включены только полученные текстовые заметки. Доступ к командам, черновики отправки, редакции и вложения не восстанавливаются."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल प्राप्त टेक्स्ट नोट शामिल हैं। टीम की पहुँच, भेजने के ड्राफ्ट, संशोधन या अटैचमेंट बहाल नहीं होते।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف موصول شدہ متنی نوٹس شامل ہیں۔ ٹیم تک رسائی، بھیجنے کے مسودے، نظرثانی یا منسلک فائلیں بحال نہیں ہوتیں۔"
          }
        }
      }
    },
