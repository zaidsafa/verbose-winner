    "Open the private in-app summary. Amounts stay off the Home Screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用内的私密汇总，金额不会显示在主屏幕上。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الملخص الخاص داخل التطبيق. تبقى المبالغ بعيدة عن الشاشة الرئيسية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le résumé privé dans l’app. Aucun montant n’apparaît sur l’écran d’accueil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el resumen privado dentro de la app. Los importes no aparecen en la pantalla de inicio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il riepilogo privato nell’app. Gli importi non appaiono sulla schermata Home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die private Übersicht in der App. Beträge bleiben vom Home-Bildschirm verborgen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o resumo privado no app. Os valores não aparecem na Tela de Início."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama içindeki özel özeti açın. Tutarlar Ana Ekran’da gösterilmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 App 內的私人摘要，金額不會顯示在主畫面上。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka ringkasan privat di aplikasi. Jumlah uang tidak ditampilkan di Layar Utama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内の非公開の集計を開きます。ホーム画面に金額は表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 안의 비공개 요약을 엽니다. 홈 화면에는 금액을 표시하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте закрытую сводку в приложении. Суммы не отображаются на экране «Домой»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में निजी सारांश खोलें। होम स्क्रीन पर राशियाँ नहीं दिखतीं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ میں نجی خلاصہ کھولیں۔ ہوم اسکرین پر رقوم نہیں دکھائی جاتیں۔"
          }
        }
      }
    },
