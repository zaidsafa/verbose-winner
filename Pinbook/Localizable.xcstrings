    },
    "Add an expense before creating a statement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مصروفاً قبل إنشاء كشف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加支出，再创建对账单。"
          }
        }
      }
    },
    "Add a periodic expense, then track what remains until it is noted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مصروفاً دورياً، ثم تابع المبلغ المتبقي حتى أرشفته."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一笔定期支出，并持续跟踪剩余金额，直到结清。"
          }
        }
      }
    },
    "Add expense": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة مصروف"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加支出"
          }
        }
      }
    },
    "Add different expense": {
      "localizations": {
        "ar": {
