          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad contiene referencias rotas entre registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup contiene riferimenti non validi tra record."
          }
