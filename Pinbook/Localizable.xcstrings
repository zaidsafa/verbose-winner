          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасно просматривайте остатки по валютам"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुद्रा के अनुसार बाकी राशि सुरक्षित रूप से देखें"
          }
        },
        "ur": {
          "stringUnit": {
