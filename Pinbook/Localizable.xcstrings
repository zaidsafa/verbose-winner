    "Open a valid team invitation to sign in, register this device, and review membership before sharing anything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح دعوة فريق صالحة لتسجيل الدخول وتسجيل هذا الجهاز ومراجعة العضوية قبل مشاركة أي شيء."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir şey paylaşmadan önce oturum açmak, bu cihazı kaydetmek ve üyeliği incelemek için geçerli bir ekip daveti açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开有效的团队邀请，登录并注册此设备；分享任何内容前，请先检查成员资格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟有效的團隊邀請，登入並註冊此裝置；分享任何內容前，請先檢查成員資格。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una invitación válida del equipo para iniciar sesión, registrar este dispositivo y revisar la membresía antes de compartir contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une invitation d’équipe valide pour vous connecter, enregistrer cet appareil et vérifier l’adhésion avant tout partage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine gültige Teameinladung, um dich anzumelden, dieses Gerät zu registrieren und die Mitgliedschaft zu prüfen, bevor du etwas teilst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um convite válido da equipe para entrar, registrar este dispositivo e revisar a associação antes de compartilhar qualquer conteúdo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी साझा करने से पहले साइन इन करने, इस डिवाइस को पंजीकृत करने और सदस्यता की समीक्षा करने के लिए मान्य टीम आमंत्रण खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka undangan tim yang valid untuk masuk, mendaftarkan perangkat ini, dan meninjau keanggotaan sebelum membagikan apa pun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なチーム招待を開いてサインインし、この端末を登録して、共有前にメンバーシップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 팀 초대를 열어 로그인하고 이 기기를 등록한 다음, 공유하기 전에 멤버십을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте действующее приглашение команды, чтобы войти, зарегистрировать это устройство и проверить членство перед отправкой данных."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un invito valido del team per accedere, registrare questo dispositivo e verificare l’appartenenza prima di condividere qualsiasi contenuto."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ بھی شیئر کرنے سے پہلے سائن اِن کرنے، اس آلے کو رجسٹر کرنے اور رکنیت کا جائزہ لینے کے لیے ٹیم کی درست دعوت کھولیں۔"
          }
        }
      }
    },
