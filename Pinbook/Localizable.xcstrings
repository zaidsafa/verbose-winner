    "Export uses the recovery key already saved on this device. Keep a safe copy of that key separately from the encrypted archive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم التصدير مفتاح الاسترداد المحفوظ على هذا الجهاز. احتفظ بنسخة آمنة من المفتاح منفصلة عن الأرشيف المشفّر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出使用此设备上已保存的恢复密钥。请将密钥的安全副本与加密归档分开保管。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出使用此裝置上已儲存的復原金鑰。請將金鑰的安全副本與加密封存檔分開保管。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’export utilise la clé de récupération enregistrée sur cet appareil. Conservez une copie sûre de cette clé séparément de l’archive chiffrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación usa la clave de recuperación guardada en este dispositivo. Conserva una copia segura de esa clave separada del archivo cifrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export verwendet den auf diesem Gerät gespeicherten Wiederherstellungsschlüssel. Bewahre eine sichere Kopie des Schlüssels getrennt vom verschlüsselten Archiv auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esportazione usa la chiave di recupero salvata su questo dispositivo. Conserva una copia sicura della chiave separatamente dall’archivio cifrato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação usa a chave de recuperação salva neste dispositivo. Mantenha uma cópia segura dessa chave separada do arquivo criptografado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarma, bu cihazda kayıtlı kurtarma anahtarını kullanır. Anahtarın güvenli bir kopyasını şifreli arşivden ayrı tutun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor menggunakan kunci pemulihan yang tersimpan di perangkat ini. Simpan salinan kunci dengan aman, terpisah dari arsip terenkripsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しには、このデバイスに保存されている復元キーを使用します。キーの安全なコピーを暗号化アーカイブとは別に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기는 이 기기에 저장된 복구 키를 사용합니다. 키의 안전한 사본을 암호화된 보관 파일과 별도로 보관하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для экспорта используется ключ восстановления, сохранённый на этом устройстве. Храните надёжную копию ключа отдельно от зашифрованного архива."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात में इस डिवाइस पर सहेजी गई पुनर्प्राप्ति कुंजी इस्तेमाल होती है। कुंजी की सुरक्षित कॉपी एन्क्रिप्ट किए गए आर्काइव से अलग रखें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "برآمد کے لیے اس آلے پر محفوظ بازیابی کی کلید استعمال ہوتی ہے۔ کلید کی محفوظ نقل خفیہ کردہ آرکائیو سے الگ رکھیں۔"
          }
        }
      }
    },
