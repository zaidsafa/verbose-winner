    "Expenses you mark as noted stay recoverable here." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبقى المصروفات التي تؤرشفها قابلة للاستعادة هنا." } } } },
    "Every statement contains exactly one person and one currency. CSV stores exact minor-unit integers; PDF formats values for reading. Files are generated locally in temporary storage." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتوي كل كشف على شخص واحد وعملة واحدة فقط. يحفظ CSV القيم الصحيحة بوحداتها الصغرى، بينما ينسق PDF القيم للقراءة. تُنشأ الملفات محلياً في تخزين مؤقت." } } } },
    "Favorite currencies" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "العملات المفضلة" } } } },
    "Favorites" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المفضلة" } } } },
    "Generated locally by Pinbook. No exchange rate was applied." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أُنشئ محلياً بواسطة Pinbook. لم يُطبّق أي سعر صرف." } } } },
