{
  "sourceLanguage": "en",
  "strings": {
    "Register this device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل هذا الجهاز"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı kaydet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册此设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊此裝置"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer cet appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät registrieren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar este dispositivo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को पंजीकृत करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarkan perangkat ini"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを登録"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 등록"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрировать устройство"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra questo dispositivo"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آلہ رجسٹر کریں"
          }
        }
      }
    },
    "This device needs its own registration before you can join the team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تسجيل هذا الجهاز قبل الانضمام إلى الفريق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibe katılmadan önce bu cihaz kaydedilmelidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入团队前，需要单独注册此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入團隊前，需要單獨註冊此裝置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo debe registrarse antes de que puedas unirte al equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil doit être enregistré avant de rejoindre l’équipe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät muss registriert werden, bevor du dem Team beitreten kannst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo precisa ser registrado antes de você entrar na equipe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीम में शामिल होने से पहले इस डिवाइस को पंजीकृत करना होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini harus didaftarkan sebelum Anda bergabung ke tim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームに参加する前に、このデバイスを登録する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀에 가입하기 전에 이 기기를 등록해야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед вступлением в команду это устройство нужно зарегистрировать."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi registrare questo dispositivo prima di entrare nel team."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیم میں شامل ہونے سے پہلے یہ آلہ رجسٹر کرنا ہوگا۔"
          }
        }
      }
    },
    "Registration does not join the team or share your private notes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل لا يضمك إلى الفريق ولا يشارك ملاحظاتك الخاصة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt, ekibe katılmaz veya özel notlarınızı paylaşmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册不会加入团队，也不会共享您的私人笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊不會加入團隊，也不會分享您的私人筆記。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro no te une al equipo ni comparte tus notas privadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement ne vous fait pas rejoindre l’équipe et ne partage pas vos notes privées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Registrierung tritt keinem Team bei und teilt keine privaten Notizen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro não entra na equipe nem compartilha suas notas privadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजीकरण से टीम में शामिल नहीं होंगे और निजी नोट साझा नहीं होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran tidak memasukkan Anda ke tim atau membagikan catatan pribadi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録してもチームには参加せず、非公開メモも共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록해도 팀에 가입되거나 비공개 메모가 공유되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация не добавляет вас в команду и не передаёт личные заметки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non ti aggiunge al team e non condivide le note private."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رجسٹریشن سے آپ ٹیم میں شامل نہیں ہوتے اور نجی نوٹس شیئر نہیں ہوتے۔"
          }
        }
      }
    },
    "I agree to register this device for the account shown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على تسجيل هذا الجهاز للحساب المعروض."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterilen hesap için bu cihazı kaydetmeyi kabul ediyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意为所示账户注册此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意為所示帳號註冊此裝置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto registrar este dispositivo para la cuenta mostrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’accepte d’enregistrer cet appareil pour le compte affiché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme zu, dieses Gerät für das angezeigte Konto zu registrieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo em registrar este dispositivo para a conta exibida."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं दिखाए गए खाते के लिए इस डिवाइस को पंजीकृत करने की सहमति देता/देती हूँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya setuju mendaftarkan perangkat ini untuk akun yang ditampilkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されたアカウントにこのデバイスを登録することに同意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 계정에 이 기기를 등록하는 데 동의합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я согласен зарегистрировать это устройство для указанного аккаунта."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acconsento a registrare questo dispositivo per l’account mostrato."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں دکھائے گئے اکاؤنٹ کے لیے یہ آلہ رجسٹر کرنے پر رضامند ہوں۔"
          }
        }
      }
    },
    "Registering device…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تسجيل الجهاز…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kaydediliyor…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在注册设备…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在註冊裝置…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrando dispositivo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement de l’appareil…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät wird registriert…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrando dispositivo…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पंजीकृत हो रहा है…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendaftarkan perangkat…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを登録中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 등록 중…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация устройства…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione del dispositivo…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلہ رجسٹر ہو رہا ہے…"
          }
        }
      }
    },
    "An earlier registration is still pending. Wait until the time shown, then continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال تسجيل سابق قيد الانتظار. انتظر حتى الوقت المعروض ثم تابع."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir kayıt hâlâ bekliyor. Gösterilen saate kadar bekleyip devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的注册仍在处理中。请等待至所示时间后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的註冊仍在處理中。請等待至所示時間後繼續。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro anterior sigue pendiente. Espera hasta la hora indicada y continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement précédent est toujours en attente. Attendez l’heure indiquée, puis continuez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Registrierung ist noch ausstehend. Warte bis zur angezeigten Zeit und fahre dann fort."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um registro anterior ainda está pendente. Aguarde até o horário exibido e continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले का पंजीकरण अभी लंबित है। दिखाए गए समय तक प्रतीक्षा करें, फिर आगे बढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran sebelumnya masih tertunda. Tunggu hingga waktu yang ditampilkan, lalu lanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の登録はまだ保留中です。表示された時刻まで待ってから続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 등록이 아직 대기 중입니다. 표시된 시간까지 기다린 후 계속하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая регистрация ещё ожидает завершения. Дождитесь указанного времени и продолжите."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una registrazione precedente è ancora in sospeso. Attendi l’ora indicata, poi continua."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلی رجسٹریشن ابھی زیر التوا ہے۔ دکھائے گئے وقت تک انتظار کریں، پھر جاری رکھیں۔"
          }
        }
      }
    },
    "The previous attempt was not found. Confirm again to retry with the same device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على المحاولة السابقة. أكّد مجددًا لإعادة المحاولة بالجهاز نفسه."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki girişim bulunamadı. Aynı cihazla yeniden denemek için tekrar onaylayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到之前的尝试。请再次确认，以使用同一设备重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到之前的嘗試。請再次確認，以使用同一裝置重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el intento anterior. Confirma de nuevo para reintentarlo con el mismo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tentative précédente est introuvable. Confirmez à nouveau pour réessayer avec le même appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Versuch wurde nicht gefunden. Bestätige erneut, um es mit demselben Gerät zu versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tentativa anterior não foi encontrada. Confirme novamente para tentar com o mesmo dispositivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला प्रयास नहीं मिला। उसी डिवाइस से दोबारा प्रयास करने के लिए फिर पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Upaya sebelumnya tidak ditemukan. Konfirmasikan lagi untuk mencoba ulang dengan perangkat yang sama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の試行が見つかりません。もう一度確認して同じデバイスで再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 시도를 찾을 수 없습니다. 같은 기기로 다시 시도하려면 다시 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая попытка не найдена. Подтвердите ещё раз, чтобы повторить с тем же устройством."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tentativo precedente non è stato trovato. Conferma di nuovo per riprovare con lo stesso dispositivo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلی کوشش نہیں ملی۔ اسی آلے سے دوبارہ کوشش کرنے کے لیے پھر تصدیق کریں۔"
          }
        }
      }
    },
    "Registration could not be confirmed. Continue to check the previous attempt before trying again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد التسجيل. تابع للتحقق من المحاولة السابقة قبل إعادة المحاولة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt doğrulanamadı. Yeniden denemeden önce önceki girişimi kontrol etmek için devam edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认注册。重试前，请继续检查之前的尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認註冊。重試前，請繼續檢查之前的嘗試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el registro. Continúa para comprobar el intento anterior antes de reintentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’a pas pu être confirmé. Continuez pour vérifier la tentative précédente avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Registrierung konnte nicht bestätigt werden. Fahre fort, um den vorherigen Versuch vor einem erneuten Versuch zu prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o registro. Continue para verificar a tentativa anterior antes de tentar novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजीकरण की पुष्टि नहीं हो सकी। दोबारा प्रयास से पहले पिछला प्रयास जाँचने के लिए आगे बढ़ें।"
          }
        },
