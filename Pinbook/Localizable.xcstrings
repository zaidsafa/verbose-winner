    "Select only the currencies you use. Pinbook keeps every balance separate and never guesses an exchange rate.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只选择你使用的货币。Pinbook 会分别保留每种余额，绝不猜测汇率。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر فقط العملات التي تستخدمها. يفصل Pinbook كل رصيد ولا يفترض أي سعر صرف."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez uniquement les devises utilisées. Pinbook sépare chaque solde et ne suppose jamais de taux de change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona solo las monedas que usas. Pinbook mantiene cada saldo separado y nunca supone un tipo de cambio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona solo le valute che usi. Pinbook mantiene ogni saldo separato e non presume mai un tasso di cambio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle nur die Währungen, die du verwendest. Pinbook hält jeden Restbetrag getrennt und nimmt niemals einen Wechselkurs an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione apenas as moedas que usa. O Pinbook mantém cada saldo separado e nunca presume uma taxa de câmbio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kullandığınız para birimlerini seçin. Pinbook her bakiyeyi ayrı tutar ve döviz kuru varsaymaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只選擇您使用的幣別。Pinbook 分開管理每種餘額，絕不擅自設定匯率。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih hanya mata uang yang digunakan. Pinbook memisahkan setiap saldo dan tidak pernah menebak kurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使う通貨だけを選択してください。Pinbookは残額を通貨ごとに分け、為替レートを勝手に設定しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하는 통화만 선택하세요. Pinbook은 잔액을 각각 관리하며 환율을 임의로 정하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите только используемые валюты. Pinbook хранит остатки отдельно и никогда не предполагает валютный курс."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस्तेमाल होने वाली मुद्राएँ चुनें। Pinbook हर बाकी राशि अलग रखता है और विनिमय दर का अनुमान नहीं लगाता।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف استعمال ہونے والی کرنسیاں منتخب کریں۔ Pinbook ہر باقی رقم الگ رکھتا ہے اور شرح مبادلہ کا اندازہ نہیں لگاتا۔"
          }
        }
      }
    },
