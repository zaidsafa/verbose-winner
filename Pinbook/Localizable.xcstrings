    "Rename" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة تسمية" } } } },
    "Rename book" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة تسمية الدفتر" } } } },
