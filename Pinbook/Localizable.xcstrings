    "Applying creates a recoverable local snapshot first. No records change until you confirm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ التطبيق أولاً لقطة محلية قابلة للاستعادة. لن تتغير أي سجلات حتى تؤكد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用前会先创建可恢复的本地快照。确认之前不会更改任何记录。"
