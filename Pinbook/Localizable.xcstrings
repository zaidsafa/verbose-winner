    "Account access could not be confirmed. Close this screen before signing in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد الوصول إلى الحساب. أغلق هذه الشاشة قبل تسجيل الدخول مجددًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap erişimi doğrulanamadı. Yeniden giriş yapmadan önce bu ekranı kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认账户访问权限。请关闭此页面后再重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認帳號存取權限。請關閉此畫面後再重新登入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el acceso a la cuenta. Cierra esta pantalla antes de volver a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au compte n’a pas pu être confirmé. Fermez cet écran avant de vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontozugriff konnte nicht bestätigt werden. Schließe diesen Bildschirm, bevor du dich erneut anmeldest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o acesso à conta. Feche esta tela antes de entrar novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते तक पहुँच की पुष्टि नहीं हो सकी। दोबारा साइन इन करने से पहले यह स्क्रीन बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses akun tidak dapat dikonfirmasi. Tutup layar ini sebelum masuk lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントへのアクセスを確認できませんでした。再度サインインする前にこの画面を閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 접근을 확인할 수 없습니다. 다시 로그인하기 전에 이 화면을 닫으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить доступ к аккаунту. Закройте этот экран перед повторным входом."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare l’accesso all’account. Chiudi questa schermata prima di accedere di nuovo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ تک رسائی کی تصدیق نہیں ہو سکی۔ دوبارہ سائن ان کرنے سے پہلے یہ اسکرین بند کریں۔"
          }
        }
      }
    },
    "Account access is ready. Registering this device and joining need separate confirmation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الحساب جاهز. تسجيل هذا الجهاز والانضمام يحتاجان إلى تأكيد منفصل."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap erişimi hazır. Bu cihazın kaydı ve ekibe katılma için ayrı onay gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户访问已就绪。注册此设备和加入团队需要分别确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號存取已就緒。註冊此裝置和加入團隊需要分別確認。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cuenta está listo. Registrar este dispositivo y unirse al equipo requieren confirmaciones separadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au compte est prêt. L’enregistrement de cet appareil et l’adhésion à l’équipe nécessitent des confirmations distinctes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontozugriff ist bereit. Die Geräteregistrierung und der Teambeitritt müssen separat bestätigt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à conta está pronto. Registrar este dispositivo e entrar na equipe exigem confirmações separadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते तक पहुँच तैयार है। इस डिवाइस का पंजीकरण और टीम में शामिल होना अलग-अलग पुष्टि माँगते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses akun siap. Pendaftaran perangkat ini dan bergabung ke tim memerlukan konfirmasi terpisah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントへのアクセスが準備できました。デバイスの登録とチームへの参加には、それぞれ確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 접근이 준비되었습니다. 이 기기 등록과 팀 가입은 각각 별도의 확인이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к аккаунту готов. Регистрация устройства и вступление в команду требуют отдельных подтверждений."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso all’account è pronto. La registrazione del dispositivo e l’adesione al team richiedono conferme separate."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ تک رسائی تیار ہے۔ اس آلے کی رجسٹریشن اور ٹیم میں شمولیت کے لیے الگ الگ تصدیق درکار ہے۔"
          }
        }
      }
    },
    "Account screen closed. Open the invitation again to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
