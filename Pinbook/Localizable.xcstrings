    "Reminder dates are stored locally. Notification authorization and delivery are not implemented yet." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُحفظ تواريخ التذكير محلياً. إذن الإشعارات وإرسالها غير منفذين بعد." } } } },
