    "Only a current team invitation can create a QR code or share link.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إنشاء رمز QR أو رابط مشاركة إلا من دعوة فريق سارية."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca geçerli bir ekip daveti QR kodu veya paylaşım bağlantısı oluşturabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当前有效的团队邀请才能生成二维码或共享链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有目前有效的團隊邀請才能產生 QR Code 或分享連結。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una invitación vigente del equipo puede crear un código QR o un enlace para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une invitation d’équipe en cours de validité peut créer un code QR ou un lien de partage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine aktuelle Teameinladung kann einen QR-Code oder Freigabelink erstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um convite atual da equipe pode criar um código QR ou link de compartilhamento."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वर्तमान टीम आमंत्रण से QR कोड या साझा करने का लिंक बनाया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya undangan tim yang masih berlaku yang dapat membuat kode QR atau tautan berbagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在有効なチーム招待のみ、QRコードまたは共有リンクを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 유효한 팀 초대만 QR 코드나 공유 링크를 만들 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать QR-код или ссылку для отправки можно только из действующего приглашения команды."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un invito del team ancora valido può creare un codice QR o un link di condivisione."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ٹیم کی موجودہ درست دعوت سے QR کوڈ یا شیئر لنک بنایا جا سکتا ہے۔"
          }
        }
      }
    },
