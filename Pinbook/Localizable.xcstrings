    "Enable a reminder when adding an expense. Permission is requested only when you save it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل تذكيراً عند إضافة مصروف. لا يُطلب الإذن إلا عند حفظه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加支出时可启用提醒。仅在保存时请求权限。"
          }
        }
      }
    },
    "Enter a valid amount for this currency.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مبلغاً صالحاً لهذه العملة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入此货币的有效金额。"
          }
        }
      }
    },
    "Enter an amount up to the remaining balance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مبلغاً لا يتجاوز الرصيد المتبقي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入的金额不能超过剩余余额。"
          }
        }
      }
    },
    "Enter a book name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم الدفتر."
