    "Save repeated expense details once, then use them from Quick Add.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تفاصيل المصروف المتكرر مرة واحدة ثم استخدمها من الإضافة السريعة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需保存一次重复支出的详情，之后即可从“快速添加”中使用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une fois les détails récurrents, puis réutilisez-les dans Ajout rapide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una vez los detalles de gastos frecuentes y reutilízalos desde Añadir rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una volta i dettagli delle spese ricorrenti e riutilizzali da Aggiunta rapida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere wiederkehrende Ausgabendetails einmal und verwende sie in der Schnellerfassung erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve os detalhes de despesas recorrentes uma vez e reutilize-os na Adição rápida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrarlanan gider ayrıntılarını bir kez kaydedin, sonra Hızlı ekle ile kullanın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將常用支出明細儲存一次，即可在「快速新增」中重複使用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan detail pengeluaran berulang sekali, lalu gunakan melalui Tambah cepat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う支出の内容を一度保存すれば、クイック追加から繰り返し使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 지출 정보를 한 번 저장한 뒤 빠른 추가에서 다시 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните данные повторяющегося расхода один раз и используйте их в Быстром добавлении."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराए जाने वाले खर्च की जानकारी एक बार सहेजें, फिर जल्दी जोड़ें से इस्तेमाल करें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بار بار آنے والے خرچ کی تفصیلات ایک بار محفوظ کریں، پھر فوری اضافہ سے استعمال کریں۔"
          }
        }
      }
    },
    "Scheduled reminders": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات المجدولة"
          }
        },
