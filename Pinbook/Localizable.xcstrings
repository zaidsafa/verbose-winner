    "Add a periodic expense, then track what remains until it is noted." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أضف مصروفاً دورياً، ثم تابع المبلغ المتبقي حتى أرشفته." } } } },
