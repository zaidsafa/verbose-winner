    "History stores only action, status, time, format, and counts. It never stores people, purposes, amounts, filenames, or receipt contents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ السجل الإجراء والحالة والوقت والتنسيق والأعداد فقط. ولا يحفظ الأشخاص أو الأغراض أو المبالغ أو أسماء الملفات أو محتوى الإيصالات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录仅保存操作、状态、时间、格式和数量，不会保存人员、用途、金额、文件名或收据内容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique ne conserve que l’action, l’état, l’heure, le format et les nombres d’éléments. Il ne contient jamais de personnes, motifs, montants, noms de fichiers ou contenus de reçus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial solo guarda acción, estado, hora, formato y cantidades de registros. Nunca guarda personas, conceptos, importes, nombres de archivos ni contenido de recibos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia salva solo azione, stato, ora, formato e conteggi. Non salva mai persone, causali, importi, nomi di file o contenuti delle ricevute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf speichert nur Aktion, Status, Zeit, Format und Anzahlen. Personen, Zwecke, Beträge, Dateinamen und Beleginhalte werden niemals darin gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico guarda apenas ação, status, horário, formato e contagens. Nunca guarda pessoas, finalidades, valores, nomes de arquivos ou conteúdo dos recibos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca işlem, durum, zaman, biçim ve adetleri saklar. Kişileri, amaçları, tutarları, dosya adlarını veya makbuz içeriklerini asla saklamaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史紀錄只儲存操作、狀態、時間、格式與數量，絕不儲存對象、用途、金額、檔案名稱或收據內容。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hanya menyimpan tindakan, status, waktu, format, dan jumlah catatan. Riwayat tidak pernah menyimpan orang, tujuan, jumlah uang, nama file, atau isi kuitansi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴に保存するのは操作、状態、日時、形式、件数のみです。対象者、用途、金額、ファイル名、領収書の内容は一切保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이력에는 작업, 상태, 시간, 형식, 개수만 저장합니다. 대상, 용도, 금액, 파일 이름, 영수증 내용은 절대 저장하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранит только действие, статус, время, формат и количество записей. Люди, назначения, суммы, имена файлов и содержимое чеков никогда не сохраняются в истории."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास में केवल कार्य, स्थिति, समय, फ़ॉर्मैट और रिकॉर्ड की गिनती रहती है। व्यक्ति, उद्देश्य, राशि, फ़ाइल नाम या रसीद की सामग्री कभी नहीं रखी जाती।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ میں صرف عمل، حالت، وقت، فارمیٹ اور ریکارڈ کی گنتی محفوظ ہوتی ہے۔ شخص، مقصد، رقم، فائل نام یا رسید کا مواد کبھی محفوظ نہیں ہوتا۔"
          }
        }
      }
    },
