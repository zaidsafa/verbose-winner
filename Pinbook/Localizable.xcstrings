    "Review balances safely by currency": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全地按货币查看余额"
          }
        },
        "ar": {
          "stringUnit": {
