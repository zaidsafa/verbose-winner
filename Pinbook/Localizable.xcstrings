    "No favorites are selected by default. Expense entry only shows the currencies you choose." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا تُحدد عملات مفضلة افتراضياً. تعرض شاشة إضافة المصروف العملات التي تختارها فقط." } } } },
    "No open balances yet." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد أرصدة مفتوحة بعد." } } } },
    "No receipts" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد إيصالات" } } } },
    "No scheduled reminders" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد تذكيرات مجدولة" } } } },
    "No statement data" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد بيانات للكشف" } } } },
    "No templates" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد قوالب" } } } },
    "Note (optional)" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ملاحظة (اختياري)" } } } },
    "Not connected" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "غير متصل" } } } },
