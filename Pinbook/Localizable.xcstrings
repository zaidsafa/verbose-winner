          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere wiederkehrende Ausgabendetails einmal und verwende sie in der Schnellerfassung erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve os detalhes de despesas recorrentes uma vez e reutilize-os na Adição rápida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrarlanan gider ayrıntılarını bir kez kaydedin, sonra Hızlı ekle ile kullanın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將常用支出明細儲存一次，即可在「快速新增」中重複使用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan detail pengeluaran berulang sekali, lalu gunakan melalui Tambah cepat."
