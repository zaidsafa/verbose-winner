    "No favorites are selected by default. Expense entry only shows the currencies you choose.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحدد عملات مفضلة افتراضياً. تعرض شاشة إضافة المصروف العملات التي تختارها فقط."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认不选择任何常用货币。添加支出时只显示你选择的货币。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune devise favorite n’est présélectionnée. La saisie des dépenses n’affiche que les devises choisies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay monedas favoritas predeterminadas. Al introducir gastos, solo aparecen las monedas que elijas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna valuta preferita è preselezionata. Durante l’inserimento delle spese compaiono solo le valute scelte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine bevorzugten Währungen vorausgewählt. Bei der Ausgabenerfassung erscheinen nur die von dir gewählten Währungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma moeda favorita vem selecionada. Ao registrar despesas, aparecem apenas as moedas escolhidas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak favori para birimi seçilmez. Gider girişinde yalnızca seçtiğiniz para birimleri gösterilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統不會預選任何常用幣別。輸入支出時只會顯示您選擇的幣別。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada mata uang favorit yang dipilih secara default. Formulir pengeluaran hanya menampilkan mata uang yang Anda pilih."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う通貨は初期設定では選択されていません。支出の入力時には、選んだ通貨だけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 통화는 기본으로 선택되어 있지 않습니다. 지출 입력 시 선택한 통화만 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранные валюты не выбраны заранее. При вводе расходов отображаются только выбранные вами валюты."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई पसंदीदा मुद्रा पहले से नहीं चुनी गई है। खर्च दर्ज करते समय केवल आपकी चुनी हुई मुद्राएँ दिखती हैं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی پسندیدہ کرنسی پہلے سے منتخب نہیں ہوتی۔ خرچ درج کرتے وقت صرف آپ کی منتخب کردہ کرنسیاں دکھائی جاتی ہیں۔"
          }
        }
      }
    },
