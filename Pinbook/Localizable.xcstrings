    "Your records stay on this device. Export a backup through Files only when you choose a destination.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录保存在此设备上。只有在你选择目标位置时，才会通过“文件”导出备份。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى سجلاتك على هذا الجهاز. لا تُصدّر نسخة احتياطية عبر الملفات إلا عندما تختار وجهة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent sur cet appareil. Une sauvegarde n’est exportée via Fichiers que vers une destination choisie par vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros permanecen en este dispositivo. Solo se exporta una copia mediante Archivos cuando eliges un destino."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi record restano su questo dispositivo. Esporta un backup tramite File solo quando scegli una destinazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben auf diesem Gerät. Ein Backup wird nur über Dateien exportiert, wenn du ein Ziel auswählst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus registros ficam neste dispositivo. Um backup só é exportado pelo Arquivos quando você escolhe um destino."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınız bu aygıtta kalır. Dosyalar üzerinden yedek, yalnızca bir hedef seçtiğinizde dışa aktarılır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的紀錄保留在此裝置上。只有選擇目的地後，才會透過「檔案」匯出備份。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan tetap di perangkat ini. Cadangan hanya diekspor melalui File ketika Anda memilih tujuan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこのデバイスに保存されます。保存先を選んだときだけ、「ファイル」からバックアップを書き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 기기에 남습니다. 대상을 선택할 때만 파일 앱을 통해 백업을 내보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи остаются на этом устройстве. Резервная копия экспортируется через «Файлы» только после выбора места назначения."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रिकॉर्ड इस डिवाइस पर रहते हैं। गंतव्य चुनने पर ही Files के ज़रिए बैकअप निर्यात होता है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ریکارڈ اسی آلے پر رہتے ہیں۔ منزل منتخب کرنے پر ہی Files کے ذریعے بیک اپ برآمد ہوتا ہے۔"
          }
        }
      }
    },
