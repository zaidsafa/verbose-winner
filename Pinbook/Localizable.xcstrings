          }
        }
      }
    },
    "We couldn't confirm the result. Check membership before trying anything else.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من تأكيد النتيجة. تحقق من العضوية قبل تجربة أي إجراء آخر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认结果。请先检查成员资格，再尝试其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認結果。請先檢查成員資格，再嘗試其他操作。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
