    "Signing in does not register this device or join the team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول لا يسجّل هذا الجهاز ولا يضمك إلى الفريق."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yapmak bu cihazı kaydetmez veya sizi ekibe dahil etmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录不会注册此设备，也不会让您加入团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入不會註冊此裝置，也不會讓您加入團隊。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión no registra este dispositivo ni te une al equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’enregistre pas cet appareil et ne vous fait pas rejoindre l’équipe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung registriert dieses Gerät nicht und tritt keinem Team bei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar não registra este dispositivo nem adiciona você à equipe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने से यह डिवाइस पंजीकृत नहीं होगा और न ही आप टीम में शामिल होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk tidak mendaftarkan perangkat ini atau memasukkan Anda ke tim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしても、このデバイスの登録やチームへの参加は行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인해도 이 기기가 등록되거나 팀에 가입되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не регистрирует это устройство и не добавляет вас в команду."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso non registra questo dispositivo e non ti aggiunge al team."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان کرنے سے یہ آلہ رجسٹر نہیں ہوتا اور نہ ہی آپ ٹیم میں شامل ہوتے ہیں۔"
          }
        }
      }
    },
    "I agree to sign in for this invitation.": {
      "localizations": {
        "ar": {
