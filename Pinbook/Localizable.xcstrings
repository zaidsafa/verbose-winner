    "Theme mode" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "وضع المظهر" } } } },
    "Totals stay separated by currency. Pinbook never applies an implicit exchange rate." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبقى الإجماليات منفصلة حسب العملة. لا يطبق Pinbook سعر صرف ضمنياً." } } } },
