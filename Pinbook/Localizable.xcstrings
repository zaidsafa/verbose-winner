        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto di unirmi a questo team con il ruolo indicato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo em entrar nesta equipe com a função indicada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekibe gösterilen rolle katılmayı kabul ediyorum."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya setuju bergabung dengan tim ini menggunakan peran yang ditampilkan."
