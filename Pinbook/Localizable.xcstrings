    "Check whether this account still belongs to the team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق مما إذا كان هذا الحساب لا يزال عضوًا في الفريق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查此账户是否仍是团队成员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查此帳號是否仍是團隊成員。"
          }
        },
        "fr": {
