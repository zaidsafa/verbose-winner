    "Generated locally by Pinbook. No exchange rate was applied.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئ محلياً بواسطة Pinbook. لم يُطبّق أي سعر صرف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Pinbook 在本地生成，未应用任何汇率。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créé localement par Pinbook. Aucun taux de change n’a été appliqué."
          }
        },
        "es": {
