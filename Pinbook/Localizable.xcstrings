    "Enable a reminder when adding an expense. Permission is requested only when you save it." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فعّل تذكيراً عند إضافة مصروف. لا يُطلب الإذن إلا عند حفظه." } } } },
    "Enter a valid amount for this currency." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل مبلغاً صالحاً لهذه العملة." } } } },
    "Enter an amount up to the remaining balance." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل مبلغاً لا يتجاوز الرصيد المتبقي." } } } },
