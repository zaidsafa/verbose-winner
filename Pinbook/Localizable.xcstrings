    "Remember every expense": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住每一笔支出"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكّر كل مصروف"
          }
        }
      }
    },
    "Keep periodic expenses organized by book, person, date, and currency—without mixing balances.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按账本、人员、日期和货币整理定期支出，不混合不同余额。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظّم المصروفات الدورية حسب الدفتر والشخص والتاريخ والعملة من دون خلط الأرصدة."
          }
        }
      }
    },
    "See what remains": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清楚掌握剩余金额"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف المتبقي بوضوح"
          }
        }
      }
    },
    "Record partial payments, keep currencies separate, and move completed expenses to Noted when you are done.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录部分付款，分别管理不同货币；完成后将支出移至“已结清”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدفعات الجزئية، وافصل العملات، وانقل المصروفات المكتملة إلى المدوّنة عند الانتهاء."
          }
        }
      }
    },
    "Private by default": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认保护隐私"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصوصية افتراضية"
          }
        }
      }
    },
    "Your records stay on this device. Export a backup through Files only when you choose a destination.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录保存在此设备上。只有在你选择目标位置时，才会通过“文件”导出备份。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى سجلاتك على هذا الجهاز. لا تُصدّر نسخة احتياطية عبر الملفات إلا عندما تختار وجهة."
          }
        }
      }
    },
    "Choose your currencies": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你的货币"
