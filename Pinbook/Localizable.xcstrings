            "value": "يحافظ النمط الفاتح على إشراق كل واجهة مع نص داكن عالي التباين."
          }
        }
      }
    },
    "Dark adapts every surface and accent for comfortable low-light reading.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式会调整所有表面和强调色，便于在低光环境中阅读。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكيّف النمط الداكن كل الأسطح والألوان لقراءة مريحة في الإضاءة الخافتة."
          }
        }
      }
    },
    "System follows the appearance selected in iPhone Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统会使用 iPhone“设置”中选择的外观。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع النظام المظهر المحدد في إعدادات iPhone."
          }
        }
      }
    },
    "Welcome to Pinbook": {
      "extractionState": "manual",
      "localizations": {
