    "Add an expense before creating a statement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مصروفاً قبل إنشاء كشف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加支出，再创建对账单。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une dépense avant de créer un relevé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un gasto antes de crear un estado de cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una spesa prima di creare un rendiconto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Ausgabe hinzu, bevor du eine Aufstellung erstellst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma despesa antes de criar um demonstrativo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döküm oluşturmadan önce bir gider ekleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先新增支出，再建立對帳單。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pengeluaran sebelum membuat laporan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細書を作成する前に支出を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명세서를 만들기 전에 지출을 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте расход перед созданием выписки."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण बनाने से पहले खर्च जोड़ें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشوارہ بنانے سے پہلے خرچ شامل کریں۔"
          }
        }
      }
    },
    "Add a periodic expense, then track what remains until it is noted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مصروفاً دورياً، ثم تابع المبلغ المتبقي حتى أرشفته."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一笔定期支出，并持续跟踪剩余金额，直到归档。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une dépense périodique et suivez son solde jusqu’à son archivage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un gasto periódico y sigue su saldo hasta archivarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una spesa periodica e segui il saldo fino all’archiviazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse eine regelmäßige Ausgabe und verfolge den Restbetrag bis zur Archivierung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma despesa periódica e acompanhe o saldo até arquivá-la."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli bir gider ekleyin ve arşivlenene kadar kalan tutarı takip edin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增定期支出，持續追蹤未付金額，直到將其歸檔。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pengeluaran berkala, lalu pantau sisanya hingga diarsipkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的な支出を追加し、アーカイブするまで残額を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기 지출을 추가하고 보관할 때까지 남은 금액을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте периодический расход и следите за остатком до его переноса в архив."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित खर्च जोड़ें और संग्रह में रखने तक उसकी बाकी राशि देखें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقاعدہ خرچ شامل کریں اور محفوظات میں رکھنے تک باقی رقم پر نظر رکھیں۔"
          }
        }
      }
    },
