    "Set a reminder date" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تحديد تاريخ تذكير" } } } },
    "Soft pastel" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ألوان هادئة" } } } },
    "Summary" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الملخص" } } } },
