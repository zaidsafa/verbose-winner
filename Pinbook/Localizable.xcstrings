    "Account actions remain unavailable until their authenticated server contracts and deletion cleanup are approved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل إجراءات الحساب غير متاحة حتى اعتماد عقود الخادم الموثَّقة وآلية التنظيف بعد الحذف."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliği doğrulanmış sunucu sözleşmeleri ve silme temizliği onaylanana kadar hesap işlemleri kullanılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在经过身份验证的服务器契约和删除清理流程获批前，账户操作将保持不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在經過身分驗證的伺服器契約和刪除清理流程獲准前，帳號操作將維持不可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones de la cuenta seguirán sin estar disponibles hasta que se aprueben los contratos autenticados del servidor y la limpieza posterior a la eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions du compte restent indisponibles jusqu’à l’approbation des contrats serveur authentifiés et du nettoyage après suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountaktionen bleiben nicht verfügbar, bis die authentifizierten Serververträge und die Bereinigung nach dem Löschen genehmigt sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações da conta permanecerão indisponíveis até que os contratos autenticados do servidor e a limpeza após a exclusão sejam aprovados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणित सर्वर अनुबंध और खाता हटाने के बाद की सफ़ाई स्वीकृत होने तक खाते की कार्रवाइयाँ उपलब्ध नहीं होंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan akun tetap tidak tersedia sampai kontrak server terautentikasi dan pembersihan setelah penghapusan disetujui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証済みサーバー契約と削除後のクリーンアップが承認されるまで、アカウント操作は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 서버 계약과 삭제 후 정리가 승인될 때까지 계정 작업을 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия с аккаунтом недоступны до утверждения серверных контрактов с аутентификацией и очистки после удаления."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni dell’account restano non disponibili finché non vengono approvati i contratti autenticati del server e la pulizia successiva all’eliminazione."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق شدہ سرور معاہدوں اور حذف کے بعد صفائی کی منظوری تک اکاؤنٹ کی کارروائیاں دستیاب نہیں رہیں گی۔"
          }
        }
      }
    },
