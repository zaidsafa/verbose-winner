    "Star an expense or create a template to make it appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مصروفاً إلى المفضلة أو أنشئ قالباً ليظهر هنا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将支出加入常用或创建模板，即可在这里显示。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une dépense aux favoris ou créez un modèle pour l’afficher ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un gasto como favorito o crea una plantilla para verlo aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una spesa ai preferiti o crea un modello per vederlo qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere eine Ausgabe als Favorit oder erstelle eine Vorlage, damit sie hier erscheint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma despesa como favorita ou crie um modelo para que apareça aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada görünmesi için bir gideri favorilere ekleyin veya şablon oluşturun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將支出加入常用項目，或建立範本，即可在此顯示。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai pengeluaran sebagai favorit atau buat templat agar muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出をよく使う項目に追加するか、テンプレートを作成すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출을 즐겨찾기에 추가하거나 템플릿을 만들면 여기에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте расход в избранное или создайте шаблон, чтобы он появился здесь."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ दिखाने के लिए खर्च को पसंदीदा बनाएँ या टेम्पलेट बनाएँ।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں دکھانے کے لیے خرچ کو پسندیدہ بنائیں یا سانچہ بنائیں۔"
          }
        }
      }
    },
