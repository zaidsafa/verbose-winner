    "Review the team and role before joining.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الفريق والدور قبل الانضمام."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入前，请查看团队和角色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入前，請查看團隊和角色。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’équipe et le rôle avant de la rejoindre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el equipo y el rol antes de unirte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das Team und die Rolle, bevor du beitrittst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il team e il ruolo prima di unirti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a equipe e a função antes de entrar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılmadan önce ekibi ve rolü kontrol edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa tim dan peran sebelum bergabung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加する前にチームと役割を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입하기 전에 팀과 역할을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте команду и роль перед вступлением."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शामिल होने से पहले टीम और भूमिका की जाँच करें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شامل ہونے سے پہلے ٹیم اور کردار کی جانچ کریں۔"
          }
        }
      }
    },
    "Joining does not share your existing private notes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانضمام لا يشارك ملاحظاتك الخاصة الحالية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入团队不会分享你已有的私人笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入團隊不會分享你現有的私人筆記。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre l’équipe ne partage pas vos notes privées existantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirte no comparte tus notas privadas existentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Beitritt werden deine vorhandenen privaten Notizen nicht geteilt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirti non condivide le tue note private esistenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar na equipe não compartilha suas notas privadas existentes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılmanız mevcut özel notlarınızı paylaşmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergabung tidak membagikan catatan pribadi Anda yang sudah ada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加しても、既存のプライベートノートは共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입해도 기존 비공개 메모는 공유되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вступление не открывает доступ к вашим существующим личным заметкам."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शामिल होने से आपके मौजूदा निजी नोट साझा नहीं होते।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شامل ہونے سے آپ کے موجودہ نجی نوٹس شیئر نہیں ہوتے۔"
          }
        }
      }
    },
    "I agree to join this team with the role shown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على الانضمام إلى هذا الفريق بالدور المعروض."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意以所示角色加入此团队。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意以所示角色加入此團隊。"
