    "Checking membership uses your saved team details. It does not resend a join request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم التحقق من العضوية تفاصيل الفريق المحفوظة. ولا يعيد إرسال طلب الانضمام."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查成员资格会使用已保存的团队信息，不会重新发送加入请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查成員資格會使用已儲存的團隊資訊，不會重新傳送加入請求。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification utilise les informations d’équipe enregistrées. Elle ne renvoie pas de demande d’adhésion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación usa los datos guardados del equipo. No vuelve a enviar una solicitud para unirte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung verwendet die gespeicherten Teamdaten. Sie sendet keine erneute Beitrittsanfrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica usa i dettagli del team salvati. Non invia nuovamente una richiesta di adesione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação usa os dados salvos da equipe. Ela não reenvia uma solicitação de entrada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyelik kontrolü, kaydedilmiş ekip bilgilerini kullanır. Katılma isteğini yeniden göndermez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan menggunakan informasi tim yang tersimpan. Permintaan bergabung tidak dikirim ulang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認には保存済みのチーム情報を使用します。参加リクエストは再送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버십 확인에는 저장된 팀 정보가 사용됩니다. 가입 요청은 다시 전송되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка использует сохранённые данные команды. Запрос на вступление повторно не отправляется."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता की जाँच में टीम की सहेजी गई जानकारी इस्तेमाल होती है। शामिल होने का अनुरोध दोबारा नहीं भेजा जाता।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکنیت کی جانچ ٹیم کی محفوظ معلومات استعمال کرتی ہے۔ شامل ہونے کی درخواست دوبارہ نہیں بھیجی جاتی۔"
          }
