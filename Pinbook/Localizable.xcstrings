    "Reminder must be in the future.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون موعد التذكير في المستقبل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒时间必须在未来。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rappel doit être programmé dans le futur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recordatorio debe tener una fecha futura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il promemoria deve avere una data futura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerung muss in der Zukunft liegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lembrete deve estar no futuro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcı gelecekte bir zamana ayarlanmalıdır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒時間必須晚於現在。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu pengingat harus setelah saat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは現在より後の日時を指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 현재보다 이후 시간으로 설정해야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время напоминания должно быть в будущем."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर का समय अभी के बाद का होना चाहिए।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کا وقت موجودہ وقت کے بعد ہونا چاہیے۔"
          }
        }
      }
    },
    "Reminder dates are stored locally. Notification authorization and delivery are not implemented yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ تواريخ التذكير محلياً. إذن الإشعارات وإرسالها غير منفذين بعد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒日期保存在本地。通知授权和推送功能尚未实现。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates des rappels sont enregistrées localement. L’autorisation et l’envoi des notifications ne sont pas encore disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas de recordatorio se guardan localmente. La autorización y el envío de notificaciones aún no están implementados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date dei promemoria sono salvate localmente. L’autorizzazione e l’invio delle notifiche non sono ancora implementati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungstermine werden lokal gespeichert. Benachrichtigungsberechtigung und Zustellung sind noch nicht implementiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas dos lembretes são salvas localmente. A autorização e o envio de notificações ainda não foram implementados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcı tarihleri aygıtta saklanır. Bildirim izni ve gönderimi henüz uygulanmadı."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒日期會儲存在本機。通知授權與發送功能尚未實作。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal pengingat disimpan secara lokal. Otorisasi dan pengiriman notifikasi belum diterapkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの日時はデバイス内に保存されます。通知の許可と配信機能はまだ実装されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 날짜는 기기에 저장됩니다. 알림 권한 요청과 발송 기능은 아직 구현되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты напоминаний хранятся локально. Запрос разрешения и отправка уведомлений пока не реализованы."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर की तारीखें डिवाइस पर सहेजी जाती हैं। सूचना की अनुमति और भेजने की सुविधा अभी लागू नहीं हुई है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کی تاریخیں آلے پر محفوظ ہوتی ہیں۔ اطلاعات کی اجازت اور بھیجنے کی سہولت ابھی نافذ نہیں ہوئی۔"
          }
        }
      },
      "extractionState": "stale"
    },
