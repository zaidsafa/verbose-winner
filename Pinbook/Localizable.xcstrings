          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掌握未付金額"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat yang tersisa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残額をひと目で確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 금액을 확인하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за остатком"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कितना बाकी है"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کتنی رقم باقی ہے"
          }
        }
      }
    },
    "Record partial payments, keep currencies separate, and move completed expenses to Noted when you are done.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录部分付款，分别管理不同货币；完成后将支出移至“已归档”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدفعات الجزئية، وافصل العملات، وانقل المصروفات المكتملة إلى المدوّنة عند الانتهاء."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les paiements partiels, séparez les devises et déplacez les dépenses terminées dans Archives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra pagos parciales, mantén las monedas separadas y mueve los gastos terminados a Archivados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra pagamenti parziali, separa le valute e sposta le spese completate in Archivio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Teilzahlungen, halte Währungen getrennt und verschiebe abgeschlossene Ausgaben nach Archiviert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre pagamentos parciais, mantenha as moedas separadas e mova as despesas concluídas para Arquivadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısmi ödemeleri kaydedin, para birimlerini ayrı tutun ve işiniz bittiğinde tamamlanan giderleri Arşiv’e taşıyın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄部分付款、分開管理各幣別，完成後將支出移至「已歸檔」。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat pembayaran sebagian, pisahkan mata uang, dan pindahkan pengeluaran yang selesai ke Arsip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の支払いを記録し、通貨を分けて管理。完了した支出は「アーカイブ済み」に移せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부분 결제를 기록하고 통화별로 구분하세요. 완료된 지출은 보관함으로 옮길 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте частичные платежи, разделяйте валюты и переносите завершённые расходы в Архив."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आंशिक भुगतान दर्ज करें, मुद्राएँ अलग रखें और पूरा होने पर खर्चों को संग्रह में ले जाएँ।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جزوی ادائیگیاں درج کریں، کرنسیاں الگ رکھیں اور مکمل ہونے پر اخراجات کو محفوظات میں لے جائیں۔"
          }
        }
      }
    },
