        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati locali sono cambiati dopo l’anteprima. Visualizza di nuovo l’anteprima del backup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Daten wurden seit der Vorschau geändert. Zeige die Backup-Vorschau erneut an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
