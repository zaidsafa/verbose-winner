            "value": "結果を確認できませんでした。他の操作を行う前にメンバーシップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 확인하지 못했습니다. 다른 작업을 하기 전에 멤버십을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить результат. Проверьте участие, прежде чем выполнять другие действия."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नतीजे की पुष्टि नहीं हो सकी। कोई और कार्रवाई करने से पहले सदस्यता जाँचें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجے کی تصدیق نہیں ہو سکی۔ کوئی اور کارروائی کرنے سے پہلے رکنیت کی جانچ کریں۔"
          }
        }
      }
    },
    "The invitation could not be reviewed. You can review it again or close this screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت مراجعة الدعوة. يمكنك مراجعتها مجددًا أو إغلاق هذه الشاشة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
