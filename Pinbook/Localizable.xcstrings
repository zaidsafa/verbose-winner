    "This backup contains broken record references.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي هذه النسخة الاحتياطية على مراجع سجلات غير صالحة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
