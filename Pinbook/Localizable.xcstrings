    "Totals stay separated by currency. Pinbook never applies an implicit exchange rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الإجماليات منفصلة حسب العملة. لا يطبق Pinbook سعر صرف ضمنياً."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总额始终按货币分别计算。Pinbook 不会隐式应用汇率。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux restent séparés par devise. Pinbook n’applique jamais de taux de change implicite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales se mantienen separados por moneda. Pinbook nunca aplica un tipo de cambio implícito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali restano separati per valuta. Pinbook non applica mai un tasso di cambio implicito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen bleiben nach Währung getrennt. Pinbook wendet niemals einen impliziten Wechselkurs an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais permanecem separados por moeda. O Pinbook nunca aplica uma taxa de câmbio implícita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplamlar para birimine göre ayrı tutulur. Pinbook hiçbir zaman örtük döviz kuru uygulamaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各幣別的總額分開計算，Pinbook 絕不會套用隱含匯率。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total tetap dipisahkan per mata uang. Pinbook tidak pernah menerapkan kurs secara tersirat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計は通貨別に分けて表示します。Pinbookが暗黙の為替レートを適用することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합계는 통화별로 분리됩니다. Pinbook은 환율을 임의로 적용하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги хранятся отдельно по валютам. Pinbook никогда не применяет неявный валютный курс."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुल राशि हर मुद्रा के लिए अलग रहती है। Pinbook कभी छिपी हुई विनिमय दर लागू नहीं करता।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر کرنسی کی مجموعی رقم الگ رہتی ہے۔ Pinbook کبھی پوشیدہ شرح مبادلہ لاگو نہیں کرتا۔"
          }
        }
      }
    },
