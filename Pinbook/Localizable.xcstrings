    "Notes are encrypted for the selected team devices. Pinbook archives a received note before acknowledging it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشفَّر الملاحظات لأجهزة الفريق المحددة. يحفظ Pinbook الملاحظة المستلمة في الأرشيف قبل تأكيد استلامها."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar seçilen ekip cihazları için şifrelenir. Pinbook, alınan notu onaylamadan önce arşivler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注会为所选团队设备加密。Pinbook 会先归档收到的备注，再确认收取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備註會為所選團隊裝置加密。Pinbook 會先封存收到的備註，再確認收取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas se cifran para los dispositivos del equipo seleccionados. Pinbook archiva cada nota recibida antes de confirmar su recepción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes sont chiffrées pour les appareils sélectionnés de l’équipe. Pinbook archive chaque note reçue avant d’en accuser réception."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen werden für die ausgewählten Teamgeräte verschlüsselt. Pinbook archiviert eine empfangene Notiz, bevor der Empfang bestätigt wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas são criptografadas para os dispositivos selecionados da equipe. O Pinbook arquiva cada nota recebida antes de confirmar o recebimento."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट चुने गए टीम डिवाइसों के लिए एन्क्रिप्ट किए जाते हैं। Pinbook प्राप्त नोट की पुष्टि करने से पहले उसे संग्रहित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan dienkripsi untuk perangkat tim yang dipilih. Pinbook mengarsipkan catatan yang diterima sebelum mengonfirmasi penerimaannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモは選択したチーム端末向けに暗号化されます。Pinbookは受信確認を送る前に、受け取ったメモをアーカイブします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모는 선택한 팀 기기용으로 암호화됩니다. Pinbook은 수신 확인 전에 받은 메모를 보관합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки шифруются для выбранных устройств команды. Pinbook архивирует полученную заметку до подтверждения её получения."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note vengono crittografate per i dispositivi selezionati del team. Pinbook archivia ogni nota ricevuta prima di confermarne la ricezione."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹس منتخب ٹیم آلات کے لیے خفیہ کیے جاتے ہیں۔ Pinbook موصولہ نوٹ کی وصولی کی تصدیق سے پہلے اسے محفوظ کرتا ہے۔"
          }
        }
      }
    },
