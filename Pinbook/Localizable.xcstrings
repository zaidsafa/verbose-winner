    "Enter 64 hexadecimal characters without separators. Imported keys are used only for this restore and are not saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل 64 حرفًا بالنظام الست عشري دون فواصل. تُستخدم المفاتيح المستوردة لهذا الاسترداد فقط ولا تُحفظ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 64 个十六进制字符，不要使用分隔符。导入的密钥仅用于此次恢复，不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 64 個十六進位字元，不要使用分隔符號。匯入的金鑰僅用於此次復原，不會儲存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez 64 caractères hexadécimaux sans séparateurs. Les clés importées servent uniquement à cette restauration et ne sont pas enregistrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce 64 caracteres hexadecimales sin separadores. Las claves importadas solo se usan para esta restauración y no se guardan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib 64 Hexadezimalzeichen ohne Trennzeichen ein. Importierte Schlüssel werden nur für diese Wiederherstellung verwendet und nicht gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci 64 caratteri esadecimali senza separatori. Le chiavi importate vengono usate solo per questo ripristino e non vengono salvate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite 64 caracteres hexadecimais sem separadores. As chaves importadas são usadas apenas nesta restauração e não são salvas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayırıcı kullanmadan 64 onaltılık karakter girin. İçe aktarılan anahtarlar yalnızca bu geri yükleme için kullanılır ve kaydedilmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan 64 karakter heksadesimal tanpa pemisah. Kunci yang diimpor hanya digunakan untuk pemulihan ini dan tidak disimpan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切り文字なしで64文字の16進数を入力してください。読み込んだキーは今回の復元にのみ使用され、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구분 기호 없이 16진수 문자 64개를 입력하세요. 가져온 키는 이번 복원에만 사용되며 저장되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 64 шестнадцатеричных символа без разделителей. Импортированные ключи используются только для этого восстановления и не сохраняются."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना विभाजक के 64 हेक्साडेसिमल अक्षर दर्ज करें। आयात की गई कुंजी केवल इस बहाली के लिए इस्तेमाल होती है और सहेजी नहीं जाती।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بغیر کسی جداکار کے 64 ہیکساڈیسیمل حروف درج کریں۔ درآمد شدہ کلید صرف اس بحالی کے لیے استعمال ہوتی ہے اور محفوظ نہیں کی جاتی۔"
          }
        }
      }
    },
    "Export encrypted archive": {
      "localizations": {
        "ar": {
