    "Pinbook follows your iPhone language by default. You can change this at any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Pinbook لغة iPhone افتراضياً. يمكنك تغييرها في أي وقت."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook 默认跟随 iPhone 的系统语言，你可以随时更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook suit la langue de votre iPhone par défaut. Vous pouvez la changer à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook usa el idioma de tu iPhone por defecto. Puedes cambiarlo cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook segue la lingua del tuo iPhone per impostazione predefinita. Puoi cambiarla in qualsiasi momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook folgt standardmäßig deiner iPhone-Sprache. Du kannst dies jederzeit ändern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pinbook segue o idioma do seu iPhone por padrão. Você pode alterá-lo a qualquer momento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook varsayılan olarak iPhone dilinizi izler. Bunu istediğiniz zaman değiştirebilirsiniz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook 預設跟隨您的 iPhone 語言，您可以隨時變更。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara default, Pinbook mengikuti bahasa iPhone Anda. Anda dapat mengubahnya kapan saja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbookは初期設定ではiPhoneの言語に合わせます。いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook은 기본적으로 iPhone 언어를 따릅니다. 언제든 변경할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию Pinbook использует язык iPhone. Его можно изменить в любое время."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook डिफ़ॉल्ट रूप से आपके iPhone की भाषा अपनाता है। आप इसे कभी भी बदल सकते हैं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinbook بنیادی طور پر آپ کے iPhone کی زبان اپناتا ہے۔ آپ اسے کسی بھی وقت بدل سکتے ہیں۔"
          }
        }
      }
    },
