            "state": "translated",
            "value": "Notas recebidas restauradas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alınan notlar geri yüklendi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan diterima dipulihkan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信ノートを復元しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 노트가 복원됨"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученные заметки восстановлены"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्त नोट बहाल किए गए"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موصول شدہ نوٹس بحال ہو گئے"
          }
        }
      }
    },
    "Existing notes were preserved. No team access or delivery receipts were restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بالملاحظات الموجودة. لم تتم استعادة الوصول إلى الفريق أو إيصالات التسليم."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原有笔记已保留。未恢复团队访问权限或送达回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原有筆記已保留。未還原團隊存取權或送達回條。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes existantes ont été conservées. Aucun accès aux équipes ni accusé de livraison n’a été restauré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservaron las notas existentes. No se restauraron el acceso a equipos ni los comprobantes de entrega."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Notizen wurden beibehalten. Teamzugriff und Zustellbestätigungen wurden nicht wiederhergestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note esistenti sono state conservate. L’accesso ai team e le ricevute di consegna non sono stati ripristinati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas existentes foram preservadas. O acesso às equipes e os comprovantes de entrega não foram restaurados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut notlar korundu. Ekip erişimi veya teslim alındıları geri yüklenmedi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang ada dipertahankan. Akses tim dan tanda terima pengiriman tidak dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のノートは保持されました。チームへのアクセスや配信確認は復元されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 노트는 유지되었습니다. 팀 접근 권한이나 전달 확인은 복원되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие заметки сохранены. Доступ к командам и подтверждения доставки не восстановлены."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा नोट सुरक्षित रखे गए। टीम की पहुँच या डिलीवरी की रसीदें बहाल नहीं की गईं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ نوٹس محفوظ رکھے گئے۔ ٹیم تک رسائی یا ترسیل کی رسیدیں بحال نہیں کی گئیں۔"
          }
        }
      }
    },
    "No recovery key is saved on this device. Enter your separately saved key to import.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مفتاح استرداد محفوظ على هذا الجهاز. أدخل المفتاح الذي حفظته بشكل منفصل للاستيراد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未保存恢复密钥。请输入你单独保管的密钥以导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置未儲存復原金鑰。請輸入你另外保管的金鑰以匯入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé de récupération n’est enregistrée sur cet appareil. Saisissez votre clé conservée séparément pour importer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave de recuperación guardada en este dispositivo. Introduce la clave que guardaste por separado para importar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist kein Wiederherstellungsschlüssel gespeichert. Gib zum Importieren deinen separat aufbewahrten Schlüssel ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave di recupero è salvata su questo dispositivo. Inserisci la chiave conservata separatamente per importare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há chave de recuperação salva neste dispositivo. Digite a chave que você guardou separadamente para importar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kayıtlı kurtarma anahtarı yok. İçe aktarmak için ayrı sakladığınız anahtarı girin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kunci pemulihan yang tersimpan di perangkat ini. Masukkan kunci yang Anda simpan terpisah untuk mengimpor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに復元キーは保存されていません。読み込むには、別に保管しているキーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 복구 키가 없습니다. 가져오려면 별도로 보관한 키를 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве нет сохранённого ключа восстановления. Для импорта введите ключ, который вы храните отдельно."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर कोई पुनर्प्राप्ति कुंजी सहेजी नहीं गई है। आयात करने के लिए अलग से सहेजी गई अपनी कुंजी दर्ज करें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر بازیابی کی کوئی کلید محفوظ نہیں ہے۔ درآمد کرنے کے لیے اپنی الگ محفوظ کردہ کلید درج کریں۔"
          }
        }
      }
    },
    "The saved recovery key is unavailable. It has not been replaced.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح الاسترداد المحفوظ غير متاح. لم يتم استبداله."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的恢复密钥不可用。该密钥未被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的復原金鑰無法使用。該金鑰未被取代。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de récupération enregistrée est indisponible. Elle n’a pas été remplacée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de recuperación guardada no está disponible. No se ha reemplazado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Wiederherstellungsschlüssel ist nicht verfügbar. Er wurde nicht ersetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di recupero salvata non è disponibile. Non è stata sostituita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de recuperação salva está indisponível. Ela não foi substituída."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kurtarma anahtarı kullanılamıyor. Anahtar değiştirilmedi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci pemulihan tersimpan tidak tersedia. Kunci tersebut tidak diganti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの復元キーを使用できません。キーは置き換えられていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 복구 키를 사용할 수 없습니다. 키는 교체되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый ключ восстановления недоступен. Он не был заменён."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई पुनर्प्राप्ति कुंजी उपलब्ध नहीं है। इसे बदला नहीं गया है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ بازیابی کی کلید دستیاب نہیں ہے۔ اسے تبدیل نہیں کیا گیا۔"
          }
        }
      }
    },
    "The archive or recovery key is invalid, unavailable or belongs to another account. Nothing was restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرشيف أو مفتاح الاسترداد غير صالح أو غير متاح أو يخص حسابًا آخر. لم تتم استعادة أي شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档或恢复密钥无效、不可用或属于其他账户。未恢复任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存檔或復原金鑰無效、無法使用或屬於其他帳號。未還原任何內容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archive ou la clé de récupération est invalide, indisponible ou appartient à un autre compte. Rien n’a été restauré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo o la clave de recuperación no es válido, no está disponible o pertenece a otra cuenta. No se restauró nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiv oder Wiederherstellungsschlüssel ist ungültig, nicht verfügbar oder gehört zu einem anderen Konto. Es wurde nichts wiederhergestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivio o la chiave di recupero non è valido, non è disponibile o appartiene a un altro account. Non è stato ripristinato nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo ou a chave de recuperação é inválido, está indisponível ou pertence a outra conta. Nada foi restaurado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv veya kurtarma anahtarı geçersiz, kullanılamıyor ya da başka bir hesaba ait. Hiçbir şey geri yüklenmedi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsip atau kunci pemulihan tidak valid, tidak tersedia, atau milik akun lain. Tidak ada yang dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブまたは復元キーが無効、使用不可、または別のアカウントのものです。何も復元されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 파일 또는 복구 키가 유효하지 않거나, 사용할 수 없거나, 다른 계정에 속합니다. 아무것도 복원되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив или ключ восстановления недействителен, недоступен или принадлежит другой учётной записи. Ничего не восстановлено."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्काइव या पुनर्प्राप्ति कुंजी अमान्य है, उपलब्ध नहीं है या किसी दूसरे खाते की है। कुछ भी बहाल नहीं हुआ।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرکائیو یا بازیابی کی کلید غلط، غیر دستیاب یا کسی دوسرے اکاؤنٹ کی ہے۔ کچھ بھی بحال نہیں ہوا۔"
          }
        }
      }
    },
    "The restore preview is no longer valid. Import and preview the archive again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد معاينة الاسترداد صالحة. استورد الأرشيف واعرض معاينته مجددًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复预览已失效。请重新导入并预览归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原預覽已失效。請重新匯入並預覽封存檔。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu de restauration n’est plus valide. Importez l’archive et affichez à nouveau l’aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de restauración ya no es válida. Importa el archivo y vuelve a previsualizarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungsvorschau ist nicht mehr gültig. Importiere das Archiv erneut und öffne die Vorschau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anteprima del ripristino non è più valida. Importa l’archivio e visualizza di nuovo l’anteprima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia da restauração não é mais válida. Importe o arquivo e visualize a prévia novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme önizlemesi artık geçerli değil. Arşivi yeniden içe aktarıp önizleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau pemulihan tidak lagi valid. Impor dan pratinjau arsip kembali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元プレビューは無効になりました。アーカイブをもう一度読み込み、プレビューしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원 미리보기가 더 이상 유효하지 않습니다. 보관 파일을 다시 가져와 미리보기를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр восстановления больше не действителен. Импортируйте архив и откройте предпросмотр заново."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाली का प्रीव्यू अब मान्य नहीं है। आर्काइव को फिर से आयात करके प्रीव्यू देखें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحالی کا پیش منظر اب درست نہیں ہے۔ آرکائیو دوبارہ درآمد کریں اور پیش منظر دیکھیں۔"
          }
        }
      }
    },
