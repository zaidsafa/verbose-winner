    "Remember every expense": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住每一笔支出"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكّر كل مصروف"
          }
        },
        "fr": {
          "stringUnit": {
