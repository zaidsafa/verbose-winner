          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel veriler önizlemeden sonra değişti. Yedeği yeniden önizleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽後本機資料已變更，請重新預覽備份。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data lokal berubah setelah pratinjau. Tinjau cadangan sekali lagi."
