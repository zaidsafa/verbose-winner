    "Keep periodic expenses organized by book, person, date, and currency—without mixing balances.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按账本、人员、日期和货币整理定期支出，不混合不同余额。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظّم المصروفات الدورية حسب الدفتر والشخص والتاريخ والعملة من دون خلط الأرصدة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez vos dépenses périodiques par carnet, personne, date et devise, sans mélanger les soldes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza los gastos periódicos por libro, persona, fecha y moneda sin mezclar saldos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza le spese periodiche per registro, persona, data e valuta, senza mescolare i saldi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne regelmäßige Ausgaben nach Buch, Person, Datum und Währung, ohne Restbeträge zu vermischen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize despesas periódicas por caderno, pessoa, data e moeda, sem misturar saldos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiyeleri karıştırmadan düzenli giderleri defter, kişi, tarih ve para birimine göre düzenleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依帳本、對象、日期與幣別整理定期支出，餘額不混在一起。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur pengeluaran berkala menurut buku, orang, tanggal, dan mata uang tanpa mencampur saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的な支出を帳簿、対象者、日付、通貨で整理し、残額を混ぜずに管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액이 섞이지 않도록 정기 지출을 장부, 대상, 날짜, 통화별로 정리하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочивайте периодические расходы по книге, человеку, дате и валюте, не смешивая остатки."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित खर्चों को खाता-बही, व्यक्ति, तारीख और मुद्रा के अनुसार रखें, बिना बाकी राशियाँ मिलाए।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقاعدہ اخراجات کو کھاتے، شخص، تاریخ اور کرنسی کے لحاظ سے رکھیں، باقی رقوم ملائے بغیر۔"
          }
        }
      }
    },
    "See what remains": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清楚掌握剩余金额"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف المتبقي بوضوح"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce qu’il reste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta lo que queda"
          }
        },
        "it": {
          "stringUnit": {
