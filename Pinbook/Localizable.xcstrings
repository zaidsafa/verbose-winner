    "Light keeps every skin bright with dark, high-contrast text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色模式让每款皮肤保持明亮，并使用高对比度深色文字。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ النمط الفاتح على إشراق كل واجهة مع نص داكن عالي التباين."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clair donne à chaque style un fond lumineux et un texte sombre très contrasté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro mantiene todos los estilos luminosos, con texto oscuro de alto contraste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiaro mantiene ogni stile luminoso con testo scuro ad alto contrasto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hell hält jeden Stil freundlich mit dunklem, kontrastreichem Text."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro deixa todos os estilos luminosos, com texto escuro de alto contraste."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık mod, her stili aydınlık tutar ve koyu, yüksek kontrastlı metin kullanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色模式讓所有風格保持明亮，搭配高對比的深色文字。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terang menjaga setiap gaya tetap cerah dengan teks gelap berkontras tinggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトはすべてのスタイルを明るくし、濃い文字で高いコントラストを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트 모드는 모든 스타일을 밝게 유지하고 어두운 고대비 글자를 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлый режим делает любой стиль ярким, с тёмным контрастным текстом."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल्का मोड हर शैली को उजला रखता है और गहरे, अधिक कंट्रास्ट वाले अक्षर दिखाता है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہلکا موڈ ہر انداز کو روشن رکھتا ہے اور گہرے، واضح تضاد والے حروف دکھاتا ہے۔"
          }
        }
      }
    },
    "Dark adapts every surface and accent for comfortable low-light reading.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式会调整所有表面和强调色，便于在低光环境中阅读。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكيّف النمط الداكن كل الأسطح والألوان لقراءة مريحة في الإضاءة الخافتة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombre adapte chaque surface et accent pour une lecture confortable dans la pénombre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuro adapta cada superficie y detalle para leer cómodamente con poca luz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuro adatta superfici e accenti per una lettura confortevole con poca luce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkel passt alle Flächen und Akzente für angenehmes Lesen bei wenig Licht an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuro adapta superfícies e destaques para uma leitura confortável com pouca luz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koyu mod, loş ışıkta rahat okuma için tüm yüzeyleri ve vurguları uyarlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式會調整各個介面底色與強調色，讓您在低光環境舒適閱讀。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelap menyesuaikan semua permukaan dan aksen agar nyaman dibaca dalam cahaya redup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークは背景とアクセントを調整し、暗い場所でも快適に読めるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드는 배경과 강조색을 조정해 어두운 곳에서도 편하게 읽을 수 있게 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмный режим адаптирует фон и акценты для удобного чтения при слабом освещении."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गहरा मोड कम रोशनी में आराम से पढ़ने के लिए पृष्ठभूमि और उभार वाले रंग बदलता है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گہرا موڈ کم روشنی میں آرام سے پڑھنے کے لیے پس منظر اور نمایاں رنگ بدلتا ہے۔"
          }
        }
      }
    },
