          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च, सारांश, संग्रह, टेम्पलेट और निर्यात में केवल चुनी हुई खाता-बही दिखाई देती है।"
          }
        },
        "ur": {
