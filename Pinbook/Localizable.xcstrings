          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipler"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tim"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チーム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीमें"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیمیں"
          }
        }
      }
    },
    "Existing notes are never overwritten. Any conflict blocks the entire restore. No team access or delivery receipts are restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتم الكتابة فوق الملاحظات الموجودة مطلقًا. أي تعارض يمنع الاسترداد بالكامل. لا تتم استعادة الوصول إلى الفريق أو إيصالات التسليم."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不会覆盖原有笔记。任何冲突都会阻止整个恢复操作。不会恢复团队访问权限或送达回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不會覆寫原有筆記。任何衝突都會阻止整個復原操作。不會還原團隊存取權或送達回條。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes existantes ne sont jamais écrasées. Tout conflit bloque la restauration entière. Aucun accès aux équipes ni accusé de livraison n’est restauré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas existentes nunca se sobrescriben. Cualquier conflicto bloquea toda la restauración. No se restauran el acceso a equipos ni los comprobantes de entrega."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Notizen werden nie überschrieben. Jeder Konflikt blockiert die gesamte Wiederherstellung. Teamzugriff und Zustellbestätigungen werden nicht wiederhergestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note esistenti non vengono mai sovrascritte. Qualsiasi conflitto blocca l’intero ripristino. L’accesso ai team e le ricevute di consegna non vengono ripristinati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas existentes nunca são sobrescritas. Qualquer conflito bloqueia toda a restauração. O acesso às equipes e os comprovantes de entrega não são restaurados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut notların üzerine asla yazılmaz. Herhangi bir çakışma tüm geri yüklemeyi engeller. Ekip erişimi veya teslim alındıları geri yüklenmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang ada tidak pernah ditimpa. Konflik apa pun memblokir seluruh pemulihan. Akses tim dan tanda terima pengiriman tidak dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のノートは上書きされません。競合があると復元全体が中止されます。チームへのアクセスや配信確認は復元されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 노트는 덮어쓰지 않습니다. 충돌이 하나라도 있으면 전체 복원이 차단됩니다. 팀 접근 권한이나 전달 확인은 복원되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие заметки никогда не перезаписываются. Любой конфликт блокирует всё восстановление. Доступ к командам и подтверждения доставки не восстанавливаются."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा नोट कभी ओवरराइट नहीं होते। कोई भी टकराव पूरी बहाली को रोक देता है। टीम की पहुँच या डिलीवरी की रसीदें बहाल नहीं होतीं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ نوٹس کبھی اووررائٹ نہیں ہوتے۔ کوئی بھی تضاد پوری بحالی کو روک دیتا ہے۔ ٹیم تک رسائی یا ترسیل کی رسیدیں بحال نہیں ہوتیں۔"
          }
        }
      }
    },
    "This backup exceeds the 128 MiB limit. Your records have not been changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup exceeds the 128 MiB limit. Your records have not been changed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز هذه النسخة الاحتياطية الحد الأقصى البالغ 128 ميبيبايت. لم يتم تغيير سجلاتك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份超过 128 MiB 的大小限制。你的记录未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份超過 128 MiB 的大小限制。你的記錄未被更改。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde dépasse la limite de 128 Mio. Vos données n’ont pas été modifiées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad supera el límite de 128 MiB. Tus registros no se han modificado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup supera il limite di 128 MiB. I tuoi dati non sono stati modificati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup überschreitet das Limit von 128 MiB. Deine Einträge wurden nicht geändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup excede o limite de 128 MiB. Seus registros não foram alterados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek 128 MiB sınırını aşıyor. Kayıtlarınız değiştirilmedi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan ini melebihi batas 128 MiB. Catatan Anda tidak diubah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは上限の128 MiBを超えています。記録は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 128 MiB 제한을 초과합니다. 기록은 변경되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия превышает лимит 128 МиБ. Ваши записи не изменены."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप 128 MiB की सीमा से बड़ा है। आपके रिकॉर्ड नहीं बदले गए हैं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بیک اپ 128 MiB کی حد سے بڑا ہے۔ آپ کے ریکارڈ تبدیل نہیں کیے گئے۔"
          }
        }
      }
    },
