        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos confirmar el resultado. Comprueba tu pertenencia antes de intentar otra acción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis konnte nicht bestätigt werden. Prüfe die Mitgliedschaft, bevor du etwas anderes versuchst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare il risultato. Verifica l’appartenenza prima di altre azioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o resultado. Verifique sua participação antes de tentar outra ação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç doğrulanamadı. Başka bir işlem yapmadan önce üyeliği kontrol edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasilnya belum dapat dikonfirmasi. Periksa keanggotaan sebelum mencoba tindakan lain."
          }
        },
        "ja": {
          "stringUnit": {
