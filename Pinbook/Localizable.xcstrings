    "Local data changed after the preview. Preview the backup again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت البيانات المحلية بعد المعاينة. عاين النسخة الاحتياطية مرة أخرى."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览后本地数据已更改，请重新预览备份。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales ont changé depuis l’aperçu. Prévisualisez à nouveau la sauvegarde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos locales cambiaron después de la vista previa. Previsualiza de nuevo la copia de seguridad."
