    "Permission is requested only when you save an expense with a reminder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُطلب الإذن إلا عند حفظ مصروف يحتوي على تذكير."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在保存带提醒的支出时请求权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation n’est demandée qu’à l’enregistrement d’une dépense avec rappel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso solo se solicita al guardar un gasto con recordatorio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso viene richiesto solo quando salvi una spesa con promemoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung wird erst beim Speichern einer Ausgabe mit Erinnerung angefragt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão só é solicitada ao salvar uma despesa com lembrete."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin yalnızca hatırlatıcılı bir gideri kaydettiğinizde istenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有儲存附帶提醒的支出時，才會要求通知權限。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin hanya diminta saat Anda menyimpan pengeluaran dengan pengingat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー付きの支出を保存するときだけ、通知の許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 설정된 지출을 저장할 때만 권한을 요청합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение запрашивается только при сохранении расхода с напоминанием."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर वाला खर्च सहेजते समय ही अनुमति माँगी जाती है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی والا خرچ محفوظ کرتے وقت ہی اجازت مانگی جاتی ہے۔"
          }
        }
      }
    },
