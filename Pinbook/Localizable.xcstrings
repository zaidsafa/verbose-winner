    "Statement values exceed the supported range.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز قيم الكشف النطاق المدعوم."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对账单金额超出支持范围。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs du relevé dépassent la plage prise en charge."
