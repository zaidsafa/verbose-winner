    "Enable a reminder when adding an expense. Permission is requested only when you save it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل تذكيراً عند إضافة مصروف. لا يُطلب الإذن إلا عند حفظه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加支出时可启用提醒。仅在保存时请求权限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez un rappel lors de l’ajout d’une dépense. L’autorisation n’est demandée qu’à l’enregistrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa un recordatorio al añadir un gasto. El permiso solo se solicita al guardarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva un promemoria quando aggiungi una spesa. Il permesso viene richiesto solo al salvataggio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere beim Hinzufügen einer Ausgabe eine Erinnerung. Die Berechtigung wird erst beim Speichern angefragt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative um lembrete ao adicionar uma despesa. A permissão só é solicitada ao salvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gider eklerken bir hatırlatıcı etkinleştirin. İzin yalnızca kaydettiğinizde istenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增支出時可啟用提醒，儲存時才會要求通知權限。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan pengingat saat menambahkan pengeluaran. Izin hanya diminta saat Anda menyimpannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出の追加時にリマインダーを有効にできます。通知の許可は保存時にのみ求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출을 추가할 때 알림을 켤 수 있습니다. 저장할 때만 권한을 요청합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите напоминание при добавлении расхода. Разрешение запрашивается только при сохранении."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खर्च जोड़ते समय रिमाइंडर चालू करें। अनुमति केवल सहेजते समय माँगी जाती है।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خرچ شامل کرتے وقت یاد دہانی فعال کریں۔ اجازت صرف محفوظ کرتے وقت مانگی جاتی ہے۔"
          }
        }
      }
    },
    "Enter a valid amount for this currency.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مبلغاً صالحاً لهذه العملة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入此货币的有效金额。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un montant valide pour cette devise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un importe válido para esta moneda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un importo valido per questa valuta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen gültigen Betrag für diese Währung ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um valor válido para esta moeda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu para birimi için geçerli bir tutar girin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入適用於此幣別的有效金額。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan jumlah yang valid untuk mata uang ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通貨に対応した有効な金額を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 통화에 맞는 올바른 금액을 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите допустимую сумму для этой валюты."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मुद्रा के लिए मान्य राशि दर्ज करें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کرنسی کے لیے درست رقم درج کریں۔"
          }
        }
      }
    },
    "Enter an amount up to the remaining balance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مبلغاً لا يتجاوز الرصيد المتبقي."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入的金额不能超过剩余余额。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un montant inférieur ou égal au solde restant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un importe que no supere el saldo pendiente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un importo non superiore al saldo residuo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib höchstens den offenen Restbetrag ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um valor que não ultrapasse o saldo restante."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan bakiyeyi aşmayan bir tutar girin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入的金額不可超過未付餘額。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan jumlah yang tidak melebihi sisa saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残額以下の金額を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 잔액 이하의 금액을 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите сумму не больше остатка."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी राशि से अधिक राशि दर्ज न करें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "باقی رقم سے زیادہ رقم درج نہ کریں۔"
          }
        }
      }
    },
