    "Attach a receipt photo to keep it with this expense.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرفق صورة إيصال للاحتفاظ بها مع هذا المصروف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上收据照片，与此支出一起保存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez une photo du reçu à cette dépense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta una foto del recibo a este gasto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega una foto della ricevuta a questa spesa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Belegfoto zu dieser Ausgabe hinzu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe uma foto do recibo a esta despesa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu giderle birlikte saklamak için bir makbuz fotoğrafı ekleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上收據照片，與這筆支出一起保存。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan foto kuitansi untuk disimpan bersama pengeluaran ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収書の写真を添付して、この支出と一緒に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증 사진을 첨부해 이 지출과 함께 보관하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепите фото чека, чтобы сохранить его вместе с расходом."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खर्च के साथ रखने के लिए रसीद की फ़ोटो जोड़ें।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رسید کی تصویر منسلک کریں تاکہ اس خرچ کے ساتھ محفوظ رہے۔"
          }
        }
