    },
    "Account cleanup could not be confirmed. Do not retry this invitation yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد إنهاء عملية الحساب. لا تعِد محاولة هذه الدعوة الآن."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap işleminin temizlendiği doğrulanamadı. Bu daveti henüz yeniden denemeyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
