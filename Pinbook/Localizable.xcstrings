    "Templates belong only to the active book and are available from Quick Add.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتمي القوالب إلى الدفتر النشط فقط وتتوفر من الإضافة السريعة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板仅属于当前账本，可从“快速添加”中使用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles appartiennent uniquement au carnet actif et sont disponibles dans Ajout rapide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas pertenecen solo al libro activo y están disponibles en Añadir rápido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli appartengono solo al registro attivo e sono disponibili in Aggiunta rapida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen gehören nur zum aktiven Buch und sind in der Schnellerfassung verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos pertencem apenas ao caderno ativo e estão disponíveis na Adição rápida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar yalnızca etkin deftere aittir ve Hızlı ekle üzerinden kullanılabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本僅屬於目前帳本，可從「快速新增」使用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat hanya milik buku aktif dan tersedia melalui Tambah cepat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは使用中の帳簿にのみ属し、クイック追加から利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 현재 장부에만 속하며 빠른 추가에서 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны принадлежат только активной книге и доступны в Быстром добавлении."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेम्पलेट केवल सक्रिय खाता-बही के होते हैं और जल्दी जोड़ें से उपलब्ध हैं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سانچے صرف فعال کھاتے کے ہوتے ہیں اور فوری اضافہ سے دستیاب ہیں۔"
          }
        }
      }
    },
    "Templates use the favorite currencies you explicitly choose in Options.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم القوالب العملات المفضلة التي تختارها صراحةً في الخيارات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板使用你在“选项”中明确选择的常用货币。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles utilisent les devises favorites choisies explicitement dans Options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas usan las monedas favoritas que elijas expresamente en Opciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli usano le valute preferite scelte esplicitamente in Opzioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen verwenden die ausdrücklich in Optionen ausgewählten bevorzugten Währungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos usam as moedas favoritas escolhidas explicitamente em Opções."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar, Seçenekler’de açıkça seçtiğiniz favori para birimlerini kullanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本只使用您在「選項」中明確選擇的常用幣別。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat menggunakan mata uang favorit yang Anda pilih sendiri di Opsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートには、「オプション」で明示的に選んだ、よく使う通貨が使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 옵션에서 직접 선택한 즐겨찾기 통화를 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны используют избранные валюты, явно выбранные вами в Параметрах."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेम्पलेट विकल्प में आपके द्वारा चुनी गई पसंदीदा मुद्राओं का इस्तेमाल करते हैं।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سانچے اختیارات میں آپ کی واضح طور پر منتخب کردہ پسندیدہ کرنسیاں استعمال کرتے ہیں۔"
          }
        }
      }
    },
    "The private file and its attachment record will be removed from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُزال الملف الخاص وسجل المرفق من هذا الجهاز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私有文件及其附件记录将从此设备中移除。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier privé et son lien avec la dépense seront supprimés de cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo privado y su registro de adjunto se eliminarán de este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file privato e il relativo record di allegato verranno eliminati da questo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die private Datei und ihr Anhangsdatensatz werden von diesem Gerät gelöscht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo privado e seu registro de anexo serão excluídos deste dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel dosya ve ek kaydı bu aygıttan silinecek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個私人檔案及其附件紀錄將從此裝置刪除。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File privat dan catatan lampirannya akan dihapus dari perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専用ストレージ内のファイルと添付記録を、このデバイスから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전용 파일과 해당 첨부 기록이 이 기기에서 삭제됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытый файл и запись о вложении будут удалены с этого устройства."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी फ़ाइल और उसका अटैचमेंट रिकॉर्ड इस डिवाइस से मिटा दिया जाएगा।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نجی فائل اور اس کے منسلکہ کا ریکارڈ اس آلے سے حذف کر دیا جائے گا۔"
          }
        }
      }
    },
    "The selected photo could not be read.": {
      "localizations": {
