    "On-device receipt text recognition is a later enhancement and is not available in this build." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التعرّف على نصوص الإيصالات على الجهاز تحسين لاحق وغير متاح في هذا الإصدار." } } } },
    "Open" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفتوح" } } } },
    "Opens the new expense form" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح نموذج المصروف الجديد" } } } },
    "Options" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخيارات" } } } },
